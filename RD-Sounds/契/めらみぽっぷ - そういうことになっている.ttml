<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal"
  ><head>
    <metadata><ttm:agent type="person" xml:id="v1" /><amll:meta key="musicName" value="そういうことになっている" /><amll:meta key="musicName" value="...空飛ぶ巫女の不思議な毎日" /><amll:meta key="artists" value="めらみぽっぷ" /><amll:meta key="artists" value="RD-Sounds" /><amll:meta key="artists" value="凋叶棕" /><amll:meta key="album" value="契" /><amll:meta key="ncmMusicId" value="3383661748" /><amll:meta key="qqMusicId" value="004dqBcC2lhYKS" /><amll:meta key="ttmlAuthorGithub" value="52458173" /><amll:meta key="ttmlAuthorGithubLogin" value="NereaFantasia" /></metadata>
  </head>
  <body dur="05:11.490">
    <div begin="00:36.127" end="05:11.490">
      <p begin="00:36.127" end="00:37.610" ttm:agent="v1" itunes:key="L0"><span begin="00:36.127" end="00:36.350">意</span><span begin="00:36.350" end="00:36.637">味</span><span begin="00:36.637" end="00:36.730">な</span><span begin="00:36.730" end="00:37.077">し</span><span begin="00:37.077" end="00:37.360">の</span><span begin="00:37.360" end="00:37.417">視</span><span begin="00:37.417" end="00:37.610">線</span><span ttm:role="x-translation" xml:lang="zh-CN">毫无意义的视线</span><span ttm:role="x-roman">imi nashi no shisen</span></p>
      <p begin="00:37.850" end="00:39.610" ttm:agent="v1" itunes:key="L1"><span begin="00:37.850" end="00:38.040">な</span><span begin="00:38.040" end="00:38.180">に</span><span begin="00:38.310" end="00:38.589">げ</span><span begin="00:38.589" end="00:38.826">な</span><span begin="00:38.826" end="00:39.044">い</span><span begin="00:39.044" end="00:39.322">笑</span><span begin="00:39.322" end="00:39.610">顔</span><span ttm:role="x-translation" xml:lang="zh-CN">漫不经心的笑容</span><span ttm:role="x-roman">nanigenai egao</span></p>
      <p begin="00:39.800" end="00:41.500" ttm:agent="v1" itunes:key="L2"><span begin="00:39.800" end="00:39.902">た</span><span begin="00:40.040" end="00:40.140">た</span><span begin="00:40.270" end="00:40.540">け</span><span begin="00:40.540" end="00:40.780">る</span><span begin="00:40.780" end="00:41.250">軽</span><span begin="00:41.250" end="00:41.500">口</span><span ttm:role="x-translation" xml:lang="zh-CN">随口甩出的玩笑话</span><span ttm:role="x-roman">tatakeru karukuchi</span></p>
      <p begin="00:41.735" end="00:43.445" ttm:agent="v1" itunes:key="L3"><span begin="00:41.735" end="00:41.840">い</span><span begin="00:41.960" end="00:42.246">き</span><span begin="00:42.246" end="00:42.493">お</span><span begin="00:42.493" end="00:42.726">い</span><span begin="00:42.726" end="00:42.959">の</span><span begin="00:42.959" end="00:43.300">権</span><span begin="00:43.300" end="00:43.445">化</span><span ttm:role="x-translation" xml:lang="zh-CN">气势的化身</span><span ttm:role="x-roman">ikioi no gonge</span></p>
      <p begin="00:43.706" end="00:45.470" ttm:agent="v1" itunes:key="L4"><span begin="00:43.706" end="00:43.880">ぶ</span><span begin="00:43.880" end="00:44.020">つ</span><span begin="00:44.173" end="00:44.401">け</span><span begin="00:44.401" end="00:44.666">ら</span><span begin="00:44.666" end="00:44.913">れ</span><span begin="00:44.913" end="00:45.227">挑</span><span begin="00:45.227" end="00:45.470">戦</span><span ttm:role="x-translation" xml:lang="zh-CN">劈头砸来的挑战</span><span ttm:role="x-roman">butsukerare chousen</span></p>
      <p begin="00:45.650" end="00:47.360" ttm:agent="v1" itunes:key="L5"><span begin="00:45.650" end="00:45.731">た</span><span begin="00:45.880" end="00:45.983">た</span><span begin="00:46.130" end="00:46.380">か</span><span begin="00:46.380" end="00:46.650">え</span><span begin="00:46.650" end="00:46.860">る</span><span begin="00:46.860" end="00:47.100">意</span><span begin="00:47.100" end="00:47.360">見</span><span ttm:role="x-translation" xml:lang="zh-CN">针锋相对的意见</span><span ttm:role="x-roman">tatakaeru iken</span></p>
      <p begin="00:47.584" end="00:49.310" ttm:agent="v1" itunes:key="L6"><span begin="00:47.584" end="00:47.780">手</span><span begin="00:47.780" end="00:47.940">の</span><span begin="00:48.083" end="00:48.335">込</span><span begin="00:48.335" end="00:48.549">ん</span><span begin="00:48.549" end="00:48.801">だ</span><span begin="00:48.801" end="00:49.070">論</span><span begin="00:49.070" end="00:49.310">駁</span><span ttm:role="x-translation" xml:lang="zh-CN">精心构筑的反驳</span><span ttm:role="x-roman">te no konda ronbaku</span></p>
      <p begin="00:49.540" end="00:51.300" ttm:agent="v1" itunes:key="L7"><span begin="00:49.540" end="00:49.769">手</span><span begin="00:49.769" end="00:49.983">が</span><span begin="00:49.983" end="00:50.235">出</span><span begin="00:50.235" end="00:50.487">る</span><span begin="00:50.487" end="00:50.734">が</span><span begin="00:50.734" end="00:51.093">早</span><span begin="00:51.093" end="00:51.300">い</span><span ttm:role="x-translation" xml:lang="zh-CN">——然而动手比动嘴更快</span><span ttm:role="x-roman">te ga deru ga hayai</span></p>
      <p begin="00:51.462" end="00:53.192" ttm:agent="v1" itunes:key="L8"><span begin="00:51.462" end="00:51.727">こ</span><span begin="00:51.727" end="00:51.991">う</span><span begin="00:51.991" end="00:52.130">な</span><span begin="00:52.130" end="00:52.250">っ</span><span begin="00:52.250" end="00:52.500">た</span><span begin="00:52.500" end="00:52.720">ら</span><span begin="00:52.720" end="00:52.910">い</span><span begin="00:52.910" end="00:53.040">つ</span><span begin="00:53.040" end="00:53.192">も</span><span ttm:role="x-translation" xml:lang="zh-CN">每到这种时候就老样子</span><span ttm:role="x-roman">kou nattara itsumo</span></p>
      <p begin="00:53.437" end="00:55.210" ttm:agent="v1" itunes:key="L9"><span begin="00:53.437" end="00:53.701">ま</span><span begin="00:53.701" end="00:53.935">る</span><span begin="00:53.935" end="00:54.199">で</span><span begin="00:54.199" end="00:54.428">気</span><span begin="00:54.428" end="00:54.661">が</span><span begin="00:54.661" end="00:54.900">利</span><span begin="00:54.900" end="00:55.030">か</span><span begin="00:55.030" end="00:55.210">ない</span><span ttm:role="x-translation" xml:lang="zh-CN">完全不懂察言观色</span><span ttm:role="x-roman">marude ki ga kikanai</span></p>
      <p begin="00:55.384" end="00:57.160" ttm:agent="v1" itunes:key="L10"><span begin="00:55.384" end="00:55.710">ま</span><span begin="00:55.710" end="00:55.878">っ</span><span begin="00:55.878" end="00:56.111">す</span><span begin="00:56.111" end="00:56.330">ぐ</span><span begin="00:56.330" end="00:56.610">火</span><span begin="00:56.610" end="00:56.980">力</span><span begin="00:56.980" end="00:57.160">で</span><span ttm:role="x-translation" xml:lang="zh-CN">一味靠火力硬上</span><span ttm:role="x-roman">massugu karyoku de</span></p>
      <p begin="00:57.343" end="00:59.090" ttm:agent="v1" itunes:key="L11"><span begin="00:57.343" end="00:57.600">と</span><span begin="00:57.600" end="00:57.710">に</span><span begin="00:57.840" end="00:58.084">か</span><span begin="00:58.084" end="00:58.230">く</span><span begin="00:58.230" end="00:58.780">速</span><span begin="00:58.780" end="00:58.900">度</span><span begin="00:58.900" end="00:59.090">で</span><span ttm:role="x-translation" xml:lang="zh-CN">总之用速度说话</span><span ttm:role="x-roman">tonikaku sokudo de</span></p>
      <p begin="00:59.270" end="01:01.028" ttm:agent="v1" itunes:key="L12"><span begin="00:59.270" end="00:59.470">まあ</span><span begin="00:59.470" end="00:59.570">負</span><span begin="00:59.770" end="01:00.012">け</span><span begin="01:00.012" end="01:00.300">な</span><span begin="01:00.300" end="01:00.478">い</span><span begin="01:00.478" end="01:00.701">け</span><span begin="01:00.701" end="01:00.890">ど</span><span begin="01:00.890" end="01:01.028">ね</span><span ttm:role="x-translation" xml:lang="zh-CN">嘛，反正我也不会输就是了</span><span ttm:role="x-roman">maa makenai kedo ne</span></p>
      <p begin="01:01.260" end="01:02.931" ttm:agent="v1" itunes:key="L13"><span begin="01:01.260" end="01:01.487">つ</span><span begin="01:01.487" end="01:01.697">い</span><span begin="01:01.697" end="01:01.954">で</span><span begin="01:01.954" end="01:02.194">に</span><span begin="01:02.194" end="01:02.452">決</span><span begin="01:02.452" end="01:02.644">め</span><span begin="01:02.640" end="01:02.840">ちゃ</span><span begin="01:02.844" end="01:02.931">え</span><span ttm:role="x-translation" xml:lang="zh-CN">顺便把事情了结掉吧</span><span ttm:role="x-roman">tsuide ni kimechae</span></p>
      <p begin="01:03.205" end="01:04.920" ttm:agent="v1" itunes:key="L14"><span begin="01:03.205" end="01:03.681">今</span><span begin="01:03.681" end="01:03.907">夜</span><span begin="01:03.907" end="01:04.130">の</span><span begin="01:04.130" end="01:04.440">い</span><span begin="01:04.440" end="01:04.700">ろ</span><span begin="01:04.700" end="01:04.770">い</span><span begin="01:04.770" end="01:04.920">ろ</span><span ttm:role="x-translation" xml:lang="zh-CN">今晚的种种——</span><span ttm:role="x-roman">kon'ya no iroiro</span></p>
      <p begin="01:05.190" end="01:06.835" ttm:agent="v1" itunes:key="L15"><span begin="01:05.190" end="01:05.387">い</span><span begin="01:05.387" end="01:05.640">ろ</span><span begin="01:05.640" end="01:05.868">い</span><span begin="01:05.868" end="01:06.010">ろ</span><span begin="01:06.010" end="01:06.130">っ</span><span begin="01:06.130" end="01:06.380">て</span><span begin="01:06.380" end="01:06.600">なん</span><span begin="01:06.605" end="01:06.730">だ</span><span begin="01:06.730" end="01:06.835">ろ</span><span ttm:role="x-translation" xml:lang="zh-CN">……种种是指什么呢</span><span ttm:role="x-roman">iroiro tte nandaro</span></p>
      <p begin="01:07.070" end="01:08.700" ttm:agent="v1" itunes:key="L16" amll:connect-next="true"><span begin="01:07.070" end="01:07.710">曖</span><span begin="01:07.710" end="01:08.310">昧で</span><span ttm:role="x-translation" xml:lang="zh-CN">暧昧的</span><span ttm:role="x-roman">aimai de</span></p>
      <p begin="01:08.700" end="01:09.930" ttm:agent="v1" itunes:key="L17"><span begin="01:08.700" end="01:09.040">いい</span><span begin="01:09.043" end="01:09.280">加</span><span begin="01:09.280" end="01:09.640">減</span><span begin="01:09.640" end="01:09.930">な</span><span ttm:role="x-translation" xml:lang="zh-CN">敷衍的</span><span ttm:role="x-roman">iikagen na</span></p>
      <p begin="01:10.131" end="01:11.410" ttm:agent="v1" itunes:key="L18"><span begin="01:10.131" end="01:10.383">幻</span><span begin="01:10.383" end="01:10.990">想</span><span begin="01:10.990" end="01:11.240">な</span><span begin="01:11.240" end="01:11.410">ら</span><span ttm:role="x-translation" xml:lang="zh-CN">如果只是幻想</span><span ttm:role="x-roman">gensou nara</span></p>
      <p begin="01:11.610" end="01:13.820" ttm:agent="v1" itunes:key="L19"><span begin="01:11.610" end="01:11.970">き</span><span begin="01:11.970" end="01:12.220">ま</span><span begin="01:12.220" end="01:12.570">り</span><span begin="01:12.570" end="01:12.820">ご</span><span begin="01:12.950" end="01:13.200">と</span><span begin="01:13.200" end="01:13.580">なん</span><span begin="01:13.580" end="01:13.820">て</span><span ttm:role="x-translation" xml:lang="zh-CN">就不靠什么规矩</span><span ttm:role="x-roman">kimarigoto nante</span></p>
      <p begin="01:13.900" end="01:15.020" ttm:agent="v1" itunes:key="L20"><span begin="01:13.900" end="01:14.150">た</span><span begin="01:14.150" end="01:14.420">よ</span><span begin="01:14.420" end="01:14.670">ら</span><span begin="01:14.670" end="01:14.910">な</span><span begin="01:14.910" end="01:15.020">い</span><span ttm:role="x-translation" xml:lang="zh-CN">也不去依赖</span><span ttm:role="x-roman">tayoranai</span></p>
      <p begin="01:15.074" end="01:23.090" ttm:agent="v1" itunes:key="L21"><span begin="01:15.074" end="01:15.500">そ</span><span begin="01:15.500" end="01:15.770">れ</span><span begin="01:15.880" end="01:16.120">で</span><span begin="01:16.120" end="01:16.400">も</span><span begin="01:16.400" end="01:16.830">す</span><span begin="01:16.830" end="01:17.010">こ</span><span begin="01:17.010" end="01:17.440">し</span><span begin="01:17.440" end="01:17.770">ず</span><span begin="01:17.770" end="01:18.070">つ</span><span begin="01:18.070" end="01:18.410">当</span><span begin="01:18.410" end="01:18.810">た</span><span begin="01:18.810" end="01:18.988">り</span><span begin="01:18.988" end="01:20.030">前</span><span begin="01:20.030" end="01:20.220">を</span><span begin="01:20.220" end="01:20.490">積</span><span begin="01:20.490" end="01:20.720">み</span><span begin="01:20.720" end="01:21.240">上</span><span begin="01:21.240" end="01:21.400">げ</span><span begin="01:21.510" end="01:21.830">てい</span><span begin="01:21.830" end="01:23.090">く</span><span ttm:role="x-translation" xml:lang="zh-CN">即便如此，还是一点一点地积累着理所当然</span><span ttm:role="x-roman">soredemo sukoshi zutsu atarimae o tsumiageteyuku</span></p>
      <p begin="01:23.624" end="01:26.242" ttm:agent="v1" itunes:key="L22"><span begin="01:23.624" end="01:23.900">そ</span><span begin="01:23.900" end="01:24.150">れ</span><span begin="01:24.150" end="01:24.350">は</span><span begin="01:24.350" end="01:24.652">き</span><span begin="01:24.652" end="01:24.856">っ</span><span begin="01:24.856" end="01:26.242">と</span><span ttm:role="x-translation" xml:lang="zh-CN">那一定是</span><span ttm:role="x-roman">sore wa kitto</span></p>
      <p begin="01:26.640" end="01:30.140" ttm:agent="v1" itunes:key="L23"><span begin="01:26.640" end="01:26.950">不</span><span begin="01:26.950" end="01:27.470">思</span><span begin="01:27.470" end="01:27.796">議</span><span begin="01:27.796" end="01:28.150">で</span><span begin="01:28.150" end="01:28.550">も</span><span begin="01:28.550" end="01:28.840">な</span><span begin="01:28.840" end="01:30.140">い</span><span ttm:role="x-translation" xml:lang="zh-CN">并不不可思议的</span><span ttm:role="x-roman">fushigi demo nai</span></p>
      <p begin="01:30.520" end="01:33.700" ttm:agent="v1" itunes:key="L24"><span begin="01:30.520" end="01:31.015">何</span><span begin="01:31.015" end="01:31.460">も</span><span begin="01:31.460" end="01:31.750">変</span><span begin="01:31.750" end="01:32.070">わ</span><span begin="01:32.070" end="01:32.420">ら</span><span begin="01:32.420" end="01:32.710">な</span><span begin="01:32.710" end="01:33.700">い</span><span ttm:role="x-translation" xml:lang="zh-CN">什么都没有改变的</span><span ttm:role="x-roman">nani mo kawaranai</span></p>
      <p begin="01:34.000" end="01:39.740" ttm:agent="v1" itunes:key="L25"><span begin="01:34.000" end="01:34.350">い</span><span begin="01:34.350" end="01:34.650">つ</span><span begin="01:34.650" end="01:35.020">も</span><span begin="01:35.020" end="01:35.420">通</span><span begin="01:35.420" end="01:35.670">り</span><span begin="01:35.670" end="01:35.910">の</span><span begin="01:36.130" end="01:36.370">あ</span><span begin="01:36.370" end="01:36.560">り</span><span begin="01:36.560" end="01:37.358">ふ</span><span begin="01:37.358" end="01:37.591">れ</span><span begin="01:37.591" end="01:37.860">た</span><span begin="01:38.013" end="01:38.200">景</span><span begin="01:38.200" end="01:38.920">色</span><span begin="01:38.920" end="01:39.280">の</span><span begin="01:39.280" end="01:39.740">中</span><span ttm:role="x-translation" xml:lang="zh-CN">一如往常的、平凡至极的景色之中</span><span ttm:role="x-roman">itsumo doori no arifureta keshiki no naka</span></p>
      <p begin="01:40.020" end="01:45.820" ttm:agent="v1" itunes:key="L26"><span begin="01:40.020" end="01:40.337">で</span><span begin="01:40.337" end="01:40.510">も</span><span begin="01:40.510" end="01:41.940">ね</span><span begin="01:42.285" end="01:42.560">不</span><span begin="01:42.560" end="01:43.040">思</span><span begin="01:43.040" end="01:43.390">議</span><span begin="01:43.390" end="01:43.760">な</span><span begin="01:43.760" end="01:44.150">も</span><span begin="01:44.150" end="01:44.440">の</span><span begin="01:44.440" end="01:45.820">ね</span><span ttm:role="x-translation" xml:lang="zh-CN">但是呢，说来也奇妙</span><span ttm:role="x-roman">demo ne fushigi na mono ne</span></p>
      <p begin="01:46.118" end="01:49.270" ttm:agent="v1" itunes:key="L27"><span begin="01:46.118" end="01:46.333">振</span><span begin="01:46.333" end="01:46.700">り</span><span begin="01:46.700" end="01:47.250">返</span><span begin="01:47.250" end="01:47.350">っ</span><span begin="01:47.350" end="01:47.660">て</span><span begin="01:47.660" end="01:48.040">み</span><span begin="01:48.040" end="01:48.320">れ</span><span begin="01:48.320" end="01:49.270">ば</span><span ttm:role="x-translation" xml:lang="zh-CN">回头看看的话</span><span ttm:role="x-roman">furikaette mireba</span></p>
      <p begin="01:49.589" end="01:58.210" ttm:agent="v1" itunes:key="L28"><span begin="01:49.589" end="01:49.800">い</span><span begin="01:49.910" end="01:50.210">つ</span><span begin="01:50.210" end="01:50.590">の</span><span begin="01:50.590" end="01:50.990">間</span><span begin="01:50.990" end="01:51.210">に</span><span begin="01:51.210" end="01:51.510">か</span><span begin="01:51.710" end="01:51.960">ちょ</span><span begin="01:51.960" end="01:52.130">っ</span><span begin="01:52.240" end="01:52.620">と</span><span begin="01:52.940" end="01:53.050">だ</span><span begin="01:53.180" end="01:53.470">け</span><span begin="01:53.619" end="01:54.140">狭</span><span begin="01:54.140" end="01:54.530">く</span><span begin="01:54.530" end="01:54.930">な</span><span begin="01:54.930" end="01:55.110">っ</span><span begin="01:55.110" end="01:55.450">た…</span><span begin="01:55.620" end="01:55.830">か</span><span begin="01:55.830" end="01:56.110">も</span><span begin="01:56.110" end="01:58.210">ね。</span><span ttm:role="x-translation" xml:lang="zh-CN">不知不觉间，距离似乎稍微变近了一些……也许吧。</span><span ttm:role="x-roman">itsu no ma ni ka chotto dake semaku natta... kamo ne.</span></p>
      <p begin="01:59.270" end="02:03.500" ttm:agent="v1" itunes:key="L29"><span begin="01:59.270" end="01:59.740">何</span><span begin="01:59.740" end="02:00.050">も</span><span begin="02:00.050" end="02:00.390">約</span><span begin="02:00.390" end="02:00.890">束</span><span begin="02:00.890" end="02:01.390">す</span><span begin="02:01.390" end="02:01.610">る</span><span begin="02:01.730" end="02:01.850">こ</span><span begin="02:01.970" end="02:02.210">と</span><span begin="02:02.210" end="02:02.450">な</span><span begin="02:02.450" end="02:02.680">ん</span><span begin="02:02.680" end="02:02.850">て</span><span begin="02:02.850" end="02:03.500">ない</span><span ttm:role="x-translation" xml:lang="zh-CN">没有任何需要约定的事</span><span ttm:role="x-roman">nani mo yakusoku suru koto nante nai</span></p>
      <p begin="02:03.900" end="02:06.940" ttm:agent="v1" itunes:key="L30"><span begin="02:03.900" end="02:04.070">ひ</span><span begin="02:04.190" end="02:04.310">と</span><span begin="02:04.410" end="02:04.550">こ</span><span begin="02:04.670" end="02:04.890">と</span><span begin="02:04.890" end="02:05.260">だ</span><span begin="02:05.260" end="02:05.510">っ</span><span begin="02:05.624" end="02:05.830">て</span><span begin="02:05.830" end="02:06.370">必</span><span begin="02:06.370" end="02:06.720">要</span><span begin="02:06.720" end="02:06.940">ない</span><span ttm:role="x-translation" xml:lang="zh-CN">一句话都不必多说</span><span ttm:role="x-roman">hitokoto datte hitsuyou nai</span></p>
      <p begin="02:07.110" end="02:11.273" ttm:agent="v1" itunes:key="L31"><span begin="02:07.110" end="02:07.330">あ</span><span begin="02:07.330" end="02:07.500">ん</span><span begin="02:07.500" end="02:07.600">た</span><span begin="02:07.600" end="02:07.810">は</span><span begin="02:07.810" end="02:07.970">ま</span><span begin="02:08.090" end="02:08.320">た</span><span begin="02:08.320" end="02:08.690">明</span><span begin="02:08.810" end="02:09.202">日</span><span begin="02:09.202" end="02:09.800">も</span><span begin="02:09.800" end="02:10.030">や</span><span begin="02:10.030" end="02:10.250">っ</span><span begin="02:10.250" end="02:10.510">て</span><span begin="02:10.510" end="02:10.660">く</span><span begin="02:10.660" end="02:11.273">る</span><span ttm:role="x-translation" xml:lang="zh-CN">你明天又会照常跑来的</span><span ttm:role="x-roman">anta wa mata ashita mo yattekuru</span></p>
      <p begin="02:11.611" end="02:14.700" ttm:agent="v1" itunes:key="L32"><span begin="02:11.611" end="02:11.950">そ</span><span begin="02:11.950" end="02:12.170">う</span><span begin="02:12.170" end="02:12.362">い</span><span begin="02:12.362" end="02:12.595">う</span><span begin="02:12.700" end="02:12.937">こ</span><span begin="02:13.080" end="02:13.440">と</span><span begin="02:13.440" end="02:13.630">に</span><span begin="02:13.630" end="02:13.920">な</span><span begin="02:13.920" end="02:14.070">っ</span><span begin="02:14.190" end="02:14.470">て</span><span begin="02:14.470" end="02:14.550">い</span><span begin="02:14.550" end="02:14.700">る</span><span ttm:role="x-translation" xml:lang="zh-CN">就是这么回事</span><span ttm:role="x-roman">sou iu koto ni natte iru</span></p>
      <p begin="02:14.840" end="02:15.790" ttm:agent="v1" itunes:key="L33"><span begin="02:14.840" end="02:15.090">そ</span><span begin="02:15.090" end="02:15.260">う</span><span begin="02:15.260" end="02:15.350">で</span><span begin="02:15.350" end="02:15.790">しょう？</span><span ttm:role="x-translation" xml:lang="zh-CN">——对吧？</span><span ttm:role="x-roman">sou deshou?</span></p>
      <p begin="02:33.180" end="02:34.680" ttm:agent="v1" itunes:key="L34"><span begin="02:33.180" end="02:33.370">い</span><span begin="02:33.370" end="02:33.560">つ</span><span begin="02:33.658" end="02:33.930">か</span><span begin="02:33.930" end="02:34.140">ら</span><span begin="02:34.140" end="02:34.420">こう</span><span begin="02:34.385" end="02:34.530">し</span><span begin="02:34.530" end="02:34.680">て</span><span ttm:role="x-translation" xml:lang="zh-CN">从何时起就这样了</span><span ttm:role="x-roman">itsu kara kou shite</span></p>
      <p begin="02:34.910" end="02:36.619" ttm:agent="v1" itunes:key="L35"><span begin="02:34.910" end="02:35.077">い</span><span begin="02:35.077" end="02:35.340">つ</span><span begin="02:35.340" end="02:35.630">ま</span><span begin="02:35.630" end="02:35.756">で</span><span begin="02:35.870" end="02:36.100">こ</span><span begin="02:36.100" end="02:36.350">う</span><span begin="02:36.350" end="02:36.480">し</span><span begin="02:36.480" end="02:36.619">て</span><span ttm:role="x-translation" xml:lang="zh-CN">又要这样到何时</span><span ttm:role="x-roman">itsu made kou shite</span></p>
      <p begin="02:36.787" end="02:38.580" ttm:agent="v1" itunes:key="L36"><span begin="02:36.787" end="02:37.070">そ</span><span begin="02:37.070" end="02:37.313">ん</span><span begin="02:37.313" end="02:37.570">な</span><span begin="02:37.570" end="02:37.745">の</span><span begin="02:37.850" end="02:38.060">ど</span><span begin="02:38.060" end="02:38.330">う</span><span begin="02:38.330" end="02:38.375">し</span><span begin="02:38.375" end="02:38.580">て</span><span ttm:role="x-translation" xml:lang="zh-CN">这种事为什么——</span><span ttm:role="x-roman">sonna no doushite</span></p>
      <p begin="02:38.820" end="02:40.530" ttm:agent="v1" itunes:key="L37"><span begin="02:38.820" end="02:39.019">問</span><span begin="02:39.019" end="02:39.290">え</span><span begin="02:39.290" end="02:39.600">な</span><span begin="02:39.600" end="02:39.717">い</span><span begin="02:39.810" end="02:40.260">関</span><span begin="02:40.260" end="02:40.530">係</span><span ttm:role="x-translation" xml:lang="zh-CN">是无法开口去问的关系</span><span ttm:role="x-roman">toenai kankei</span></p>
      <p begin="02:40.680" end="02:42.490" ttm:agent="v1" itunes:key="L38"><span begin="02:40.680" end="02:41.250">勝</span><span begin="02:41.250" end="02:41.370">利</span><span begin="02:41.370" end="02:41.700">者</span> <span begin="02:41.700" end="02:41.867">負</span><span begin="02:41.980" end="02:42.280">け</span><span begin="02:42.280" end="02:42.490">犬</span><span ttm:role="x-translation" xml:lang="zh-CN">胜者与败犬</span><span ttm:role="x-roman">shourisha makeinu</span></p>
      <p begin="02:42.720" end="02:44.430" ttm:agent="v1" itunes:key="L39"><span begin="02:42.720" end="02:43.180">休</span><span begin="02:43.180" end="02:43.306">ま</span><span begin="02:43.306" end="02:43.700">せ</span><span begin="02:43.700" end="02:43.950">休</span><span begin="02:43.950" end="02:44.100">ま</span><span begin="02:44.100" end="02:44.290">さ</span><span begin="02:44.290" end="02:44.430">れ</span><span ttm:role="x-translation" xml:lang="zh-CN">让人歇、被人拦</span><span ttm:role="x-roman">yasumase yasumasare</span></p>
      <p begin="02:44.670" end="02:46.352" ttm:agent="v1" itunes:key="L40"><span begin="02:44.670" end="02:45.150">夜</span><span begin="02:45.150" end="02:45.300">を</span><span begin="02:45.410" end="02:45.630">駆</span><span begin="02:45.630" end="02:45.790">け</span><span begin="02:45.930" end="02:46.130">た</span><span begin="02:46.130" end="02:46.255">な</span><span begin="02:46.255" end="02:46.352">ら</span><span ttm:role="x-translation" xml:lang="zh-CN">若奔驰过夜晚的话</span><span ttm:role="x-roman">yoru o kaketanara</span></p>
      <p begin="02:46.620" end="02:48.350" ttm:agent="v1" itunes:key="L41"><span begin="02:46.620" end="02:46.840">ま</span><span begin="02:46.840" end="02:46.960">た</span><span begin="02:47.100" end="02:47.320">日</span><span begin="02:47.320" end="02:47.450">だ</span><span begin="02:47.450" end="02:47.580">っ</span><span begin="02:47.580" end="02:47.856">て</span><span begin="02:47.856" end="02:48.190">昇</span><span begin="02:48.190" end="02:48.350">る</span><span ttm:role="x-translation" xml:lang="zh-CN">太阳也自然会再升起</span><span ttm:role="x-roman">mata hi datte noboru</span></p>
      <p begin="02:48.570" end="02:50.260" ttm:agent="v1" itunes:key="L42"><span begin="02:48.570" end="02:48.820">意</span><span begin="02:48.820" end="02:49.048">味</span><span begin="02:49.048" end="02:49.160">な</span><span begin="02:49.160" end="02:49.530">し</span><span begin="02:49.530" end="02:49.678">の</span><span begin="02:49.678" end="02:49.960">視</span><span begin="02:49.960" end="02:50.260">線</span><span ttm:role="x-translation" xml:lang="zh-CN">毫无意义的视线</span><span ttm:role="x-roman">imi nashi no shisen</span></p>
      <p begin="02:50.520" end="02:52.240" ttm:agent="v1" itunes:key="L43"><span begin="02:50.520" end="02:50.730">な</span><span begin="02:50.730" end="02:50.867">に</span><span begin="02:51.010" end="02:51.260">げ</span><span begin="02:51.260" end="02:51.510">な</span><span begin="02:51.510" end="02:51.730">い</span><span begin="02:51.730" end="02:51.970">笑</span><span begin="02:51.970" end="02:52.240">顔</span><span ttm:role="x-translation" xml:lang="zh-CN">漫不经心的笑容</span><span ttm:role="x-roman">nanigenai egao</span></p>
      <p begin="02:52.470" end="02:54.180" ttm:agent="v1" itunes:key="L44"><span begin="02:52.470" end="02:52.584">た</span><span begin="02:52.584" end="02:52.778">た</span><span begin="02:52.930" end="02:53.210">け</span><span begin="02:53.210" end="02:53.335">る</span><span begin="02:53.440" end="02:53.900">軽</span><span begin="02:53.900" end="02:54.180">口</span><span ttm:role="x-translation" xml:lang="zh-CN">随口甩出的玩笑话</span><span ttm:role="x-roman">tatakeru karukuchi</span></p>
      <p begin="02:54.430" end="02:56.190" ttm:agent="v1" itunes:key="L45"><span begin="02:54.430" end="02:54.620">い</span><span begin="02:54.620" end="02:54.910">き</span><span begin="02:54.910" end="02:55.180">お</span><span begin="02:55.180" end="02:55.410">い</span><span begin="02:55.410" end="02:55.620">の</span><span begin="02:55.620" end="02:56.000">権</span><span begin="02:56.000" end="02:56.190">化</span><span ttm:role="x-translation" xml:lang="zh-CN">气势的化身</span><span ttm:role="x-roman">ikioi no gonge</span></p>
      <p begin="02:56.360" end="02:58.230" ttm:agent="v1" itunes:key="L46"><span begin="02:56.360" end="02:56.514">ぶ</span><span begin="02:56.514" end="02:56.860">つ</span><span begin="02:56.860" end="02:57.100">け</span><span begin="02:57.100" end="02:57.350">ら</span><span begin="02:57.350" end="02:57.520">れ</span><span begin="02:57.520" end="02:57.910">挑</span><span begin="02:57.910" end="02:58.230">戦</span><span ttm:role="x-translation" xml:lang="zh-CN">劈头砸来的挑战</span><span ttm:role="x-roman">butsukerare chousen</span></p>
      <p begin="02:58.330" end="03:00.050" ttm:agent="v1" itunes:key="L47"><span begin="02:58.330" end="02:58.544">た</span><span begin="02:58.544" end="02:58.650">た</span><span begin="02:58.790" end="02:59.070">か</span><span begin="02:59.070" end="02:59.300">え</span><span begin="02:59.300" end="02:59.540">る</span><span begin="02:59.540" end="02:59.760">意</span><span begin="02:59.760" end="03:00.050">見</span><span ttm:role="x-translation" xml:lang="zh-CN">针锋相对的意见</span><span ttm:role="x-roman">tatakaeru iken</span></p>
      <p begin="03:00.270" end="03:02.720" ttm:agent="v1" itunes:key="L48" amll:connect-next="true"><span begin="03:00.270" end="03:00.500">手</span><span begin="03:00.500" end="03:00.672">の</span><span begin="03:00.760" end="03:01.010">込</span><span begin="03:01.010" end="03:01.240">ん</span><span begin="03:01.240" end="03:01.490">だ</span><span begin="03:01.490" end="03:01.705">論</span><span begin="03:01.705" end="03:02.000">駁</span> <span begin="03:02.140" end="03:02.224">の</span><span begin="03:02.224" end="03:02.480">前</span><span begin="03:02.480" end="03:02.601">に</span><span ttm:role="x-translation" xml:lang="zh-CN">精心构筑的反驳——之前</span><span ttm:role="x-roman">te no konda ronbaku no mae ni</span></p>
      <p begin="03:02.720" end="03:19.987" ttm:agent="v1" itunes:key="L49" amll:connect-next="true"><span begin="03:02.720" end="03:02.970">今</span><span begin="03:02.970" end="03:03.180">度</span><span begin="03:03.180" end="03:03.440">は</span><span begin="03:03.440" end="03:03.660">わ</span><span begin="03:03.660" end="03:03.740">た</span><span begin="03:03.740" end="03:04.016">し</span><span begin="03:04.160" end="03:04.400">が</span><span begin="03:04.400" end="03:04.810">手</span><span begin="03:04.810" end="03:05.110">を</span><span begin="03:05.110" end="03:05.320">出</span><span begin="03:05.320" end="03:07.890">す！</span><span ttm:role="x-translation" xml:lang="zh-CN">这次轮到我先出手了！</span><span ttm:role="x-roman">kondo wa watashi ga te o dasu!</span></p>
      <p begin="03:19.987" end="03:22.290" ttm:agent="v1" itunes:key="L50"><span begin="03:19.987" end="03:20.320">大</span><span begin="03:20.320" end="03:21.000">切</span><span begin="03:21.000" end="03:21.350">な</span><span begin="03:21.350" end="03:21.710">も</span><span begin="03:21.710" end="03:22.000">の</span><span begin="03:22.000" end="03:22.290">は</span><span ttm:role="x-translation" xml:lang="zh-CN">重要的东西</span><span ttm:role="x-roman">taisetsu na mono wa</span></p>
      <p begin="03:22.360" end="03:24.180" ttm:agent="v1" itunes:key="L51"><span begin="03:22.360" end="03:22.950">言</span><span begin="03:22.950" end="03:23.170">葉</span><span begin="03:23.170" end="03:23.420">じゃ</span><span begin="03:23.420" end="03:23.620">な</span><span begin="03:23.620" end="03:23.900">く</span><span begin="03:23.900" end="03:24.180">て</span><span ttm:role="x-translation" xml:lang="zh-CN">不是言语</span><span ttm:role="x-roman">kotoba ja nakute</span></p>
      <p begin="03:24.310" end="03:25.810" ttm:agent="v1" itunes:key="L52"><span begin="03:24.310" end="03:24.910">言</span><span begin="03:24.910" end="03:25.230">葉</span><span begin="03:25.230" end="03:25.620">よ</span><span begin="03:25.620" end="03:25.810">り</span><span ttm:role="x-translation" xml:lang="zh-CN">而是比言语</span><span ttm:role="x-roman">kotoba yori</span></p>
      <p begin="03:25.810" end="03:28.070" ttm:agent="v1" itunes:key="L53"><span begin="03:25.810" end="03:26.190">不</span><span begin="03:26.190" end="03:26.800">確</span><span begin="03:26.800" end="03:27.090">か</span><span begin="03:27.090" end="03:27.320">な</span><span begin="03:27.320" end="03:27.570">も</span><span begin="03:27.570" end="03:27.800">の</span><span begin="03:27.800" end="03:28.070">で</span><span ttm:role="x-translation" xml:lang="zh-CN">更不确定的什么</span><span ttm:role="x-roman">futashika na mono de</span></p>
      <p begin="03:28.190" end="03:32.100" ttm:agent="v1" itunes:key="L54"><span begin="03:28.190" end="03:28.560">代</span><span begin="03:28.560" end="03:28.820">わ</span><span begin="03:28.820" end="03:29.170">り</span><span begin="03:29.170" end="03:29.530">に</span><span begin="03:29.530" end="03:29.750">置</span><span begin="03:29.750" end="03:29.920">き</span><span begin="03:29.920" end="03:30.360">置</span><span begin="03:30.360" end="03:30.460">い</span><span begin="03:30.460" end="03:30.740">て</span><span begin="03:30.740" end="03:31.150">か</span><span begin="03:31.150" end="03:31.480">れ</span><span begin="03:31.480" end="03:31.740">て</span><span begin="03:31.740" end="03:32.100">く</span><span ttm:role="x-translation" xml:lang="zh-CN">被一件件留置在此、取而代之的</span><span ttm:role="x-roman">kawari ni okioite kareteku</span></p>
      <p begin="03:32.230" end="03:35.860" ttm:agent="v1" itunes:key="L55"><span begin="03:32.230" end="03:32.580">幻</span><span begin="03:32.580" end="03:33.170">想</span><span begin="03:33.170" end="03:33.340">の</span><span begin="03:33.340" end="03:33.910">そ</span><span begin="03:33.910" end="03:34.140">の</span><span begin="03:34.140" end="03:34.380">お</span><span begin="03:34.380" end="03:34.452">も</span><span begin="03:34.452" end="03:35.860">さ</span><span ttm:role="x-translation" xml:lang="zh-CN">是幻想的重量</span><span ttm:role="x-roman">gensou no sono omosa</span></p>
      <p begin="03:36.270" end="03:39.010" ttm:agent="v1" itunes:key="L56"><span begin="03:36.270" end="03:36.860">空</span><span begin="03:36.860" end="03:37.090">の</span><span begin="03:37.090" end="03:37.290">む</span><span begin="03:37.290" end="03:37.620">こ</span><span begin="03:37.620" end="03:39.010">う</span><span ttm:role="x-translation" xml:lang="zh-CN">天空的那一边</span><span ttm:role="x-roman">sora no mukou</span></p>
      <p begin="03:39.350" end="03:42.890" ttm:agent="v1" itunes:key="L57"><span begin="03:39.350" end="03:39.630">不</span><span begin="03:39.630" end="03:40.100">思</span><span begin="03:40.100" end="03:40.479">議</span><span begin="03:40.479" end="03:40.850">で</span><span begin="03:40.850" end="03:41.230">も</span><span begin="03:41.230" end="03:41.530">な</span><span begin="03:41.530" end="03:42.890">い</span><span ttm:role="x-translation" xml:lang="zh-CN">并不不可思议</span><span ttm:role="x-roman">fushigi demo nai</span></p>
      <p begin="03:43.180" end="03:46.320" ttm:agent="v1" itunes:key="L58"><span begin="03:43.180" end="03:43.750">影</span><span begin="03:43.750" end="03:44.100">ひ</span><span begin="03:44.100" end="03:44.330">と</span><span begin="03:44.330" end="03:44.700">つ</span><span begin="03:44.700" end="03:45.080">も</span><span begin="03:45.080" end="03:45.400">な</span><span begin="03:45.400" end="03:46.320">い</span><span ttm:role="x-translation" xml:lang="zh-CN">连一道影子都没有的</span><span ttm:role="x-roman">kage hitotsu mo nai</span></p>
      <p begin="03:46.620" end="03:52.410" ttm:agent="v1" itunes:key="L59"><span begin="03:46.620" end="03:46.800">き</span><span begin="03:46.800" end="03:46.881">っ</span><span begin="03:47.070" end="03:47.300">と</span><span begin="03:47.300" end="03:47.650">退</span><span begin="03:47.650" end="03:48.310">屈</span><span begin="03:48.310" end="03:48.520">で</span><span begin="03:48.780" end="03:49.013">ず</span><span begin="03:49.013" end="03:49.179">っ</span><span begin="03:49.310" end="03:49.630">と</span><span begin="03:49.902" end="03:50.600">静</span><span begin="03:50.600" end="03:50.970">か</span><span begin="03:50.970" end="03:51.190">な</span><span begin="03:51.190" end="03:51.950">毎</span><span begin="03:51.950" end="03:52.410">日</span><span ttm:role="x-translation" xml:lang="zh-CN">一定是无聊的、一直安静的每一天</span><span ttm:role="x-roman">kitto taikutsu de zutto shizuka na mainichi</span></p>
      <p begin="03:52.700" end="03:58.480" ttm:agent="v1" itunes:key="L60"><span begin="03:52.700" end="03:52.920">で</span><span begin="03:52.920" end="03:53.150">も</span><span begin="03:53.150" end="03:54.600">ね</span><span begin="03:54.910" end="03:55.246">不</span><span begin="03:55.246" end="03:55.700">思</span><span begin="03:55.700" end="03:56.040">議</span><span begin="03:56.040" end="03:56.470">な</span><span begin="03:56.470" end="03:56.840">も</span><span begin="03:56.840" end="03:57.090">の</span><span begin="03:57.090" end="03:58.480">ね</span><span ttm:role="x-translation" xml:lang="zh-CN">但是呢，说来也奇妙</span><span ttm:role="x-roman">demo ne fushigi na mono ne</span></p>
      <p begin="03:58.800" end="04:01.973" ttm:agent="v1" itunes:key="L61"><span begin="03:58.800" end="03:59.280">思</span><span begin="03:59.280" end="03:59.358">い</span><span begin="03:59.358" end="03:59.668">返</span><span begin="03:59.668" end="03:59.980">し</span><span begin="03:59.980" end="04:00.340">て</span><span begin="04:00.340" end="04:00.622">み</span><span begin="04:00.770" end="04:00.980">れ</span><span begin="04:00.980" end="04:01.973">ば</span><span ttm:role="x-translation" xml:lang="zh-CN">仔细回想的话</span><span ttm:role="x-roman">omoikaeshite mireba</span></p>
      <p begin="04:02.260" end="04:11.540" ttm:agent="v1" itunes:key="L62"><span begin="04:02.260" end="04:02.560">い</span><span begin="04:02.560" end="04:02.910">つ</span><span begin="04:02.910" end="04:03.260">の</span><span begin="04:03.260" end="04:03.660">間</span><span begin="04:03.660" end="04:03.880">に</span><span begin="04:03.880" end="04:04.170">か</span><span begin="04:04.370" end="04:04.620">ちょ</span><span begin="04:04.620" end="04:04.870">っ</span><span begin="04:04.870" end="04:05.320">と</span><span begin="04:05.494" end="04:05.900">さ</span><span begin="04:05.900" end="04:06.222">わ</span><span begin="04:06.222" end="04:06.473">が</span><span begin="04:06.473" end="04:06.810">し</span><span begin="04:06.810" end="04:07.200">く</span><span begin="04:07.200" end="04:07.560">な</span><span begin="04:07.560" end="04:07.800">っ</span><span begin="04:07.800" end="04:08.140">た…</span><span begin="04:08.330" end="04:08.529">か</span><span begin="04:08.529" end="04:08.708">も</span><span begin="04:08.708" end="04:11.540">ね。</span><span ttm:role="x-translation" xml:lang="zh-CN">不知不觉间，似乎稍微变得喧闹了一些……也许吧。</span><span ttm:role="x-roman">itsu no ma ni ka chotto sawagashiku natta... kamo ne.</span></p>
      <p begin="04:23.650" end="04:27.950" ttm:agent="v1" itunes:key="L63"><span begin="04:23.650" end="04:24.180">何</span><span begin="04:24.180" end="04:24.440">も</span><span begin="04:24.440" end="04:24.790">約</span><span begin="04:24.790" end="04:25.270">束</span><span begin="04:25.270" end="04:25.780">す</span><span begin="04:25.780" end="04:26.080">る</span><span begin="04:26.080" end="04:26.340">こ</span><span begin="04:26.340" end="04:26.610">と</span><span begin="04:26.610" end="04:26.840">な</span><span begin="04:26.840" end="04:27.060">ん</span><span begin="04:27.060" end="04:27.230">て</span><span begin="04:27.230" end="04:27.950">ない</span><span ttm:role="x-translation" xml:lang="zh-CN">没有任何需要约定的事</span><span ttm:role="x-roman">nani mo yakusoku suru koto nante nai</span></p>
      <p begin="04:28.290" end="04:31.270" ttm:agent="v1" itunes:key="L64"><span begin="04:28.290" end="04:28.820">契</span><span begin="04:28.820" end="04:29.070">り</span><span begin="04:29.070" end="04:29.260">を</span><span begin="04:29.260" end="04:30.050">結</span><span begin="04:30.050" end="04:30.250">ぶ</span><span begin="04:30.250" end="04:30.510">こ</span><span begin="04:30.510" end="04:30.730">と</span><span begin="04:30.730" end="04:31.010">も</span><span begin="04:31.010" end="04:31.140">な</span><span begin="04:31.140" end="04:31.270">い</span><span ttm:role="x-translation" xml:lang="zh-CN">也不必立下什么誓约</span><span ttm:role="x-roman">chigiri o musubu koto mo nai</span></p>
      <p begin="04:31.490" end="04:35.740" ttm:agent="v1" itunes:key="L65"><span begin="04:31.490" end="04:31.664">な</span><span begin="04:31.664" end="04:31.803">ぜ</span><span begin="04:31.803" end="04:31.970">っ</span><span begin="04:31.970" end="04:32.190">て</span><span begin="04:32.190" end="04:32.480">そ</span><span begin="04:32.480" end="04:32.730">ん</span><span begin="04:32.730" end="04:32.950">な</span><span begin="04:32.950" end="04:33.160">の</span><span begin="04:33.160" end="04:33.430">ぜ</span><span begin="04:33.430" end="04:33.580">ん</span><span begin="04:33.580" end="04:33.940">ぜ</span><span begin="04:33.940" end="04:34.160">ん</span><span begin="04:34.160" end="04:34.400">意</span><span begin="04:34.400" end="04:34.640">味</span><span begin="04:34.640" end="04:34.900">が</span><span begin="04:34.900" end="04:35.030">な</span><span begin="04:35.030" end="04:35.740">い</span><span ttm:role="x-translation" xml:lang="zh-CN">因为那种东西完全没有意义</span><span ttm:role="x-roman">naze tte sonna no zenzen imi ga nai</span></p>
      <p begin="04:36.120" end="04:39.130" ttm:agent="v1" itunes:key="L66"><span begin="04:36.120" end="04:36.300">い</span><span begin="04:36.300" end="04:36.540">つ</span><span begin="04:36.540" end="04:36.800">の</span><span begin="04:36.800" end="04:37.040">ま</span><span begin="04:37.040" end="04:37.460">に</span><span begin="04:37.460" end="04:37.810">や</span><span begin="04:37.810" end="04:38.030">ら</span><span begin="04:38.030" end="04:38.520">関</span><span begin="04:38.520" end="04:38.910">係</span><span begin="04:38.910" end="04:39.130">ない</span><span ttm:role="x-translation" xml:lang="zh-CN">不知不觉间已经无所谓了</span><span ttm:role="x-roman">itsu no ma ni yara kankei nai</span></p>
      <p begin="04:39.300" end="04:40.050" ttm:agent="v1" itunes:key="L67"><span begin="04:39.300" end="04:39.540">だ</span><span begin="04:39.540" end="04:39.670">か</span><span begin="04:39.670" end="04:39.790">ら</span><span begin="04:39.790" end="04:40.050">ね</span><span ttm:role="x-translation" xml:lang="zh-CN">所以呢</span><span ttm:role="x-roman">dakara ne</span></p>
      <p begin="04:40.050" end="04:43.530" ttm:agent="v1" itunes:key="L68"><span begin="04:40.050" end="04:40.208">い</span><span begin="04:40.208" end="04:40.441">つ</span><span begin="04:40.441" end="04:40.710">も</span><span begin="04:40.710" end="04:40.950">の</span><span begin="04:40.950" end="04:41.360">よ</span><span begin="04:41.360" end="04:41.700">う</span><span begin="04:41.700" end="04:41.866">に</span><span begin="04:41.866" end="04:42.180">邪</span><span begin="04:42.180" end="04:42.332">魔</span><span begin="04:42.332" end="04:42.690">さ</span><span begin="04:42.690" end="04:42.810">れ</span><span begin="04:42.810" end="04:43.530">て</span><span ttm:role="x-translation" xml:lang="zh-CN">一如既往地被捣乱</span><span ttm:role="x-roman">itsumo no you ni jama sarete</span></p>
      <p begin="04:43.940" end="04:46.870" ttm:agent="v1" itunes:key="L69"><span begin="04:43.940" end="04:44.120">い</span><span begin="04:44.120" end="04:44.400">つ</span><span begin="04:44.400" end="04:44.680">も</span><span begin="04:44.680" end="04:44.890">の</span><span begin="04:44.890" end="04:45.290">よ</span><span begin="04:45.290" end="04:45.610">う</span><span begin="04:45.610" end="04:45.830">に</span><span begin="04:45.830" end="04:46.340">喧</span><span begin="04:46.340" end="04:46.590">嘩</span><span begin="04:46.590" end="04:46.700">し</span><span begin="04:46.700" end="04:46.870">て</span><span ttm:role="x-translation" xml:lang="zh-CN">一如既往地吵架</span><span ttm:role="x-roman">itsumo no you ni kenka shite</span></p>
      <p begin="04:47.040" end="04:51.270" ttm:agent="v1" itunes:key="L70"><span begin="04:47.040" end="04:47.340">そ</span><span begin="04:47.340" end="04:47.450">れ</span><span begin="04:47.450" end="04:47.580">で</span><span begin="04:47.580" end="04:47.850">も</span><span begin="04:47.850" end="04:48.020">い</span><span begin="04:48.020" end="04:48.270">つ</span><span begin="04:48.270" end="04:48.510">も</span><span begin="04:48.510" end="04:48.790">の</span><span begin="04:48.790" end="04:49.180">よ</span><span begin="04:49.180" end="04:49.530">う</span><span begin="04:49.530" end="04:49.770">に</span><span begin="04:49.770" end="04:50.000">や</span><span begin="04:50.000" end="04:50.160">っ</span><span begin="04:50.280" end="04:50.520">て</span><span begin="04:50.520" end="04:50.640">く</span><span begin="04:50.640" end="04:51.270">る</span><span ttm:role="x-translation" xml:lang="zh-CN">即便如此还是一如既往地找上门来</span><span ttm:role="x-roman">soredemo itsumo no you ni yattekuru</span></p>
      <p begin="04:51.630" end="04:54.700" ttm:agent="v1" itunes:key="L71"><span begin="04:51.630" end="04:52.000">そ</span><span begin="04:52.000" end="04:52.210">う</span><span begin="04:52.210" end="04:52.460">い</span><span begin="04:52.460" end="04:52.600">う</span><span begin="04:52.700" end="04:53.060">こ</span><span begin="04:53.060" end="04:53.420">と</span><span begin="04:53.420" end="04:53.680">に</span><span begin="04:53.680" end="04:53.900">な</span><span begin="04:53.900" end="04:54.060">っ</span><span begin="04:54.170" end="04:54.460">て</span><span begin="04:54.460" end="04:54.560">い</span><span begin="04:54.560" end="04:54.700">る</span><span ttm:role="x-translation" xml:lang="zh-CN">就是这么回事</span><span ttm:role="x-roman">sou iu koto ni natte iru</span></p>
      <p begin="04:54.850" end="04:55.560" ttm:agent="v1" itunes:key="L72"><span begin="04:54.850" end="04:55.090">そ</span><span begin="04:55.090" end="04:55.230">う</span><span begin="04:55.230" end="04:55.310">で</span><span begin="04:55.310" end="04:55.560">しょう？</span><span ttm:role="x-translation" xml:lang="zh-CN">——对吧？</span><span ttm:role="x-roman">sou deshou?</span></p>
      <p begin="04:55.630" end="04:58.950" ttm:agent="v1" itunes:key="L73"><span begin="04:55.630" end="04:55.815">た</span><span begin="04:55.910" end="04:56.079">と</span><span begin="04:56.079" end="04:56.339">え</span><span begin="04:56.339" end="04:56.864">明</span><span begin="04:56.990" end="04:57.254">日</span><span begin="04:57.254" end="04:57.460">が</span><span begin="04:57.460" end="04:58.060">最</span><span begin="04:58.060" end="04:58.330">後</span><span begin="04:58.330" end="04:58.470">で</span><span begin="04:58.470" end="04:58.950">も</span><span ttm:role="x-translation" xml:lang="zh-CN">哪怕明天就是最后一天</span><span ttm:role="x-roman">tatoe ashita ga saigo demo</span></p>
      <p begin="04:59.503" end="05:02.500" ttm:agent="v1" itunes:key="L74"><span begin="04:59.503" end="04:59.960">今</span><span begin="04:59.960" end="05:00.449">生</span><span begin="05:00.449" end="05:00.900">の</span><span begin="05:00.900" end="05:01.462">別</span><span begin="05:01.462" end="05:01.727">れ</span><span begin="05:01.727" end="05:01.924">の</span><span begin="05:01.924" end="05:02.190">日</span><span begin="05:02.190" end="05:02.261">で</span><span begin="05:02.261" end="05:02.500">も</span><span ttm:role="x-translation" xml:lang="zh-CN">哪怕是今生诀别之日</span><span ttm:role="x-roman">konjou no wakare no hi demo</span></p>
      <p begin="05:02.710" end="05:06.880" ttm:agent="v1" itunes:key="L75"><span begin="05:02.710" end="05:02.920">あ</span><span begin="05:02.920" end="05:03.080">ん</span><span begin="05:03.080" end="05:03.200">た</span><span begin="05:03.200" end="05:03.410">は</span><span begin="05:03.410" end="05:03.868">何</span><span begin="05:03.868" end="05:04.114">も</span><span begin="05:04.114" end="05:04.361">気</span><span begin="05:04.361" end="05:04.675">に</span><span begin="05:04.675" end="05:05.065">せ</span><span begin="05:05.065" end="05:05.348">ず</span><span begin="05:05.348" end="05:05.594">や</span><span begin="05:05.594" end="05:05.750">っ</span><span begin="05:05.841" end="05:06.100">て</span><span begin="05:06.100" end="05:06.230">く</span><span begin="05:06.230" end="05:06.880">る</span><span ttm:role="x-translation" xml:lang="zh-CN">你也会什么都不在意地跑来</span><span ttm:role="x-roman">anta wa nani mo ki ni sezu yattekuru</span></p>
      <p begin="05:07.301" end="05:10.264" ttm:agent="v1" itunes:key="L76"><span begin="05:07.301" end="05:07.535">そ</span><span begin="05:07.535" end="05:07.781">う</span><span begin="05:07.781" end="05:08.080">い</span><span begin="05:08.080" end="05:08.220">う</span><span begin="05:08.279" end="05:08.590">こ</span><span begin="05:08.700" end="05:09.015">と</span><span begin="05:09.015" end="05:09.292">に</span><span begin="05:09.292" end="05:09.526">な</span><span begin="05:09.526" end="05:09.660">っ</span><span begin="05:09.759" end="05:10.070">て</span><span begin="05:10.070" end="05:10.091">い</span><span begin="05:10.091" end="05:10.264">る</span><span ttm:role="x-translation" xml:lang="zh-CN">就是这么回事</span><span ttm:role="x-roman">sou iu koto ni natte iru</span></p>
      <p begin="05:10.436" end="05:11.490" ttm:agent="v1" itunes:key="L77"><span begin="05:10.436" end="05:10.730">そ</span><span begin="05:10.730" end="05:10.860">う</span><span begin="05:10.860" end="05:10.940">で</span><span begin="05:10.940" end="05:11.490">しょう？</span><span ttm:role="x-translation" xml:lang="zh-CN">——对吧？</span><span ttm:role="x-roman">sou deshou?</span></p>
    </div>
  </body></tt
>

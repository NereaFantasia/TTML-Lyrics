<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="少女と星と運命と"/><amll:meta key="artists" value="めらみぽっぷ"/><amll:meta key="artists" value="RD-Sounds"/><amll:meta key="artists" value="凋叶棕"/><amll:meta key="album" value="少女と星と運命と"/><amll:meta key="ncmMusicId" value="3374224241"/><amll:meta key="ttmlAuthorGithub" value="52458173"/><amll:meta key="ttmlAuthorGithubLogin" value="NereaFantasia"/></metadata></head><body dur="05:40.453"><div begin="00:03.085" end="05:40.453"><p begin="00:03.085" end="00:05.497" ttm:agent="v1" itunes:key="L0"><span begin="00:03.085" end="00:03.315">空</span><span begin="00:03.315" end="00:04.388">よ</span><span begin="00:04.388" end="00:04.612">星</span><span begin="00:04.612" end="00:05.497">よ</span><span ttm:role="x-translation" xml:lang="zh-CN">苍穹啊，星辰啊</span><span ttm:role="x-roman">Sora yo, hoshi yo</span></p><p begin="00:05.708" end="00:08.395" ttm:agent="v1" itunes:key="L1"><span begin="00:05.708" end="00:05.912">こ</span><span begin="00:05.912" end="00:06.058">の</span><span begin="00:06.058" end="00:06.377">娘</span><span begin="00:06.377" end="00:06.596">に</span><span begin="00:06.596" end="00:06.742">与</span><span begin="00:06.742" end="00:07.062">え</span><span begin="00:07.062" end="00:07.227">た</span><span begin="00:07.227" end="00:07.600">も</span><span begin="00:07.600" end="00:07.784">う</span><span begin="00:07.784" end="00:07.944">た</span><span begin="00:07.944" end="00:08.094">の</span><span begin="00:08.094" end="00:08.395">は</span><span ttm:role="x-translation" xml:lang="zh-CN">赐予这孩子的</span><span ttm:role="x-roman">Kono ko ni ataeta mouta no wa</span></p><p begin="00:08.467" end="00:10.915" ttm:agent="v1" itunes:key="L2"><span begin="00:08.467" end="00:08.631">そ</span><span begin="00:08.631" end="00:08.777">れ</span><span begin="00:08.777" end="00:09.761">わ</span><span begin="00:09.761" end="00:09.941">希</span><span begin="00:09.941" end="00:10.226">望</span><span begin="00:10.226" end="00:10.915">—</span><span ttm:role="x-translation" xml:lang="zh-CN">那是希望——</span><span ttm:role="x-roman">Sore wa kibō—</span></p><p begin="00:11.210" end="00:14.217" ttm:agent="v1" itunes:key="L3"><span begin="00:11.210" end="00:11.394">或</span><span begin="00:11.394" end="00:11.520">い</span><span begin="00:11.520" end="00:11.827">は</span><span begin="00:11.827" end="00:11.971">、</span><span begin="00:11.971" end="00:12.295">呪</span><span begin="00:12.295" end="00:12.562">い</span><span begin="00:12.562" end="00:12.919">の</span><span begin="00:12.919" end="00:13.622">類</span><span begin="00:13.622" end="00:13.995">か</span><span begin="00:13.995" end="00:14.217">？</span><span ttm:role="x-translation" xml:lang="zh-CN">亦或是，诅咒之类？</span><span ttm:role="x-roman">Arui wa, noroi no tagui ka?</span></p><p begin="00:14.039" end="00:16.363" ttm:agent="v1" itunes:key="L4"><span begin="00:14.039" end="00:14.358">あ</span><span begin="00:14.358" end="00:15.430">あ</span>　<span begin="00:15.430" end="00:15.750">夜</span><span begin="00:15.750" end="00:16.363">に</span><span ttm:role="x-translation" xml:lang="zh-CN">啊，在那夜里</span><span ttm:role="x-roman">Aa, yoru ni</span></p><p begin="00:16.732" end="00:19.413" ttm:agent="v1" itunes:key="L5"><span begin="00:16.732" end="00:17.125">空</span><span begin="00:17.125" end="00:17.619">高</span><span begin="00:17.619" end="00:17.799">く</span><span begin="00:17.799" end="00:18.153">見</span><span begin="00:18.153" end="00:18.284">上</span><span begin="00:18.284" end="00:18.448">げ</span><span begin="00:18.448" end="00:18.817">た</span><span begin="00:18.817" end="00:19.016">の</span><span begin="00:19.016" end="00:19.147">な</span><span begin="00:19.147" end="00:19.413">ら</span><span ttm:role="x-translation" xml:lang="zh-CN">若仰望高远的天空</span><span ttm:role="x-roman">Sora takaku miageta no nara</span></p><p begin="00:19.566" end="00:21.215" ttm:agent="v1" itunes:key="L6"><span begin="00:19.566" end="00:19.730">そ</span><span begin="00:19.730" end="00:19.895">こ</span><span begin="00:19.895" end="00:20.793">に</span><span begin="00:20.793" end="00:21.016">は</span><span begin="00:21.016" end="00:21.215">—</span><span ttm:role="x-translation" xml:lang="zh-CN">那里——</span><span ttm:role="x-roman">Soko ni wa—</span></p><p begin="00:21.585" end="00:24.572" ttm:agent="v1" itunes:key="L7"><span begin="00:21.585" end="00:21.871">い</span><span begin="00:21.871" end="00:22.157">つ</span><span begin="00:22.157" end="00:22.516">か</span><span begin="00:22.516" end="00:22.676">の</span>　<span begin="00:22.676" end="00:23.136">星</span><span begin="00:23.136" end="00:23.699">が</span><span begin="00:23.699" end="00:24.125">—</span><span begin="00:24.125" end="00:24.572">—</span><span ttm:role="x-translation" xml:lang="zh-CN">有那曾经的星——</span><span ttm:role="x-roman">Itsuka no hoshi ga——</span></p><p begin="00:36.794" end="00:41.279" ttm:agent="v1" itunes:key="L8"><span begin="00:36.794" end="00:38.094">已</span><span begin="00:38.094" end="00:38.831">の</span><span begin="00:38.831" end="00:39.500">運</span><span begin="00:39.500" end="00:40.203">命</span><span begin="00:40.203" end="00:40.838">こ</span><span begin="00:40.838" end="00:41.279">そ</span><span ttm:role="x-translation" xml:lang="zh-CN">自身的命运</span><span ttm:role="x-roman">Onore no unmei koso</span></p><p begin="00:41.554" end="00:46.456" ttm:agent="v1" itunes:key="L9"><span begin="00:41.554" end="00:42.989">己</span><span begin="00:42.989" end="00:43.624">の</span><span begin="00:43.624" end="00:44.308">も</span><span begin="00:44.308" end="00:44.769">の</span><span begin="00:44.769" end="00:45.040">だ</span><span begin="00:45.040" end="00:46.456">と</span><span ttm:role="x-translation" xml:lang="zh-CN">本属于自己的</span><span ttm:role="x-roman">Onore no mono da to</span></p><p begin="00:47.125" end="00:49.942" ttm:agent="v1" itunes:key="L10"><span begin="00:47.125" end="00:47.479">み</span><span begin="00:47.479" end="00:47.872">な</span><span begin="00:47.872" end="00:48.560">言</span><span begin="00:48.560" end="00:48.880">う</span><span begin="00:48.880" end="00:49.234">の</span><span begin="00:49.234" end="00:49.942">は</span><span ttm:role="x-translation" xml:lang="zh-CN">众人如是说</span><span ttm:role="x-roman">Mina iu no wa</span></p><p begin="00:50.255" end="00:52.007" ttm:agent="v1" itunes:key="L11"><span begin="00:50.255" end="00:50.575">容</span><span begin="00:50.575" end="00:50.876">易</span><span begin="00:50.876" end="00:51.249">き</span><span begin="00:51.249" end="00:51.588">こ</span><span begin="00:51.588" end="00:52.007">と</span><span ttm:role="x-translation" xml:lang="zh-CN">何其容易</span><span ttm:role="x-roman">Tayasuki koto</span></p><p begin="00:53.175" end="00:57.708" ttm:agent="v1" itunes:key="L12"><span begin="00:53.175" end="00:53.393">言</span><span begin="00:53.393" end="00:54.029">葉</span><span begin="00:54.029" end="00:54.435">の</span><span begin="00:54.435" end="00:55.448">上</span><span begin="00:55.448" end="00:56.137">な</span><span begin="00:56.137" end="00:57.708">ら</span><span ttm:role="x-translation" xml:lang="zh-CN">若只在言语之上</span><span ttm:role="x-roman">Kotoba no ue nara</span></p><p begin="00:58.919" end="01:03.282" ttm:agent="v1" itunes:key="L13"><span begin="00:58.919" end="00:59.661">け</span><span begin="00:59.661" end="00:59.948">れ</span><span begin="00:59.948" end="01:00.291">ど</span><span begin="01:00.291" end="01:00.994">己</span><span begin="01:00.994" end="01:01.381">の</span><span begin="01:01.381" end="01:03.045">持</span><span begin="01:03.045" end="01:03.282">つ</span><span ttm:role="x-translation" xml:lang="zh-CN">然而自己手中的</span><span ttm:role="x-roman">Keredo onore no motsu</span></p><p begin="01:03.792" end="01:08.594" ttm:agent="v1" itunes:key="L14"><span begin="01:03.792" end="01:04.131">そ</span><span begin="01:04.131" end="01:04.466">の</span><span begin="01:04.466" end="01:05.098">運</span><span begin="01:05.098" end="01:06.514">命</span><span begin="01:06.514" end="01:06.833">は</span><span begin="01:06.833" end="01:07.193">ま</span><span begin="01:07.193" end="01:08.594">た</span><span ttm:role="x-translation" xml:lang="zh-CN">那命运亦会</span><span ttm:role="x-roman">Sono unmei wa mata</span></p><p begin="01:09.312" end="01:12.402" ttm:agent="v1" itunes:key="L15"><span begin="01:09.312" end="01:09.652">と</span><span begin="01:09.652" end="01:10.006">き</span><span begin="01:10.006" end="01:10.725">に</span><span begin="01:10.725" end="01:11.307">容</span><span begin="01:11.307" end="01:12.044">易</span><span begin="01:12.044" end="01:12.402">く</span><span ttm:role="x-translation" xml:lang="zh-CN">时而轻易地</span><span ttm:role="x-roman">Toki ni tayasuku</span></p><p begin="01:12.790" end="01:14.391" ttm:agent="v1" itunes:key="L16"><span begin="01:12.790" end="01:13.465">牙</span><span begin="01:13.465" end="01:13.804">を</span><span begin="01:13.804" end="01:14.173">剥</span><span begin="01:14.173" end="01:14.391">く</span><span ttm:role="x-translation" xml:lang="zh-CN">露出獠牙</span><span ttm:role="x-roman">Kiba wo muku</span></p><p begin="01:14.846" end="01:19.713" ttm:agent="v1" itunes:key="L17"><span begin="01:14.846" end="01:15.186">消</span><span begin="01:15.186" end="01:15.579">え</span><span begin="01:15.579" end="01:16.241">て</span><span begin="01:16.241" end="01:16.561">ゆ</span><span begin="01:16.561" end="01:16.906">く</span><span begin="01:16.906" end="01:18.205">慟</span><span begin="01:18.205" end="01:19.713">哭</span><span ttm:role="x-translation" xml:lang="zh-CN">渐渐消逝的恸哭</span><span ttm:role="x-roman">Kiete yuku dōkoku</span></p><p begin="01:20.412" end="01:23.100" ttm:agent="v1" itunes:key="L18"><span begin="01:20.412" end="01:20.769">腕</span><span begin="01:20.769" end="01:21.117">に</span>　<span begin="01:21.117" end="01:22.154">膝</span><span begin="01:22.154" end="01:22.280">に</span><span begin="01:22.280" end="01:23.100">と</span><span ttm:role="x-translation" xml:lang="zh-CN">手臂上，膝盖上</span><span ttm:role="x-roman">Ude ni, hiza ni to</span></p><p begin="01:23.465" end="01:26.208" ttm:agent="v1" itunes:key="L19"><span begin="01:23.465" end="01:23.824">負</span><span begin="01:23.824" end="01:24.372">つ</span><span begin="01:24.372" end="01:24.880">た</span><span begin="01:24.880" end="01:25.219">擦</span><span begin="01:25.219" end="01:25.573">り</span><span begin="01:25.573" end="01:26.208">傷</span><span ttm:role="x-translation" xml:lang="zh-CN">所负的擦伤</span><span ttm:role="x-roman">Otta surikizu</span></p><p begin="01:26.649" end="01:28.733" ttm:agent="v1" itunes:key="L20"><span begin="01:26.649" end="01:27.669">泥</span><span begin="01:27.669" end="01:28.001">に</span><span begin="01:28.001" end="01:28.482">塗</span><span begin="01:28.482" end="01:28.733">れ</span><span ttm:role="x-translation" xml:lang="zh-CN">满身泥污</span><span ttm:role="x-roman">Doro ni mamire</span></p><p begin="01:28.995" end="01:31.526" ttm:agent="v1" itunes:key="L21"><span begin="01:28.995" end="01:29.368">薄</span><span begin="01:29.368" end="01:29.829">汚</span><span begin="01:29.829" end="01:30.396">れ</span><span begin="01:30.396" end="01:30.750">た</span><span begin="01:30.750" end="01:31.526">姿</span><span ttm:role="x-translation" xml:lang="zh-CN">微染尘污的身影</span><span ttm:role="x-roman">Usuyogoreta sugata</span></p><p begin="01:32.224" end="01:36.932" ttm:agent="v1" itunes:key="L22"><span begin="01:32.224" end="01:32.893">だ</span><span begin="01:32.893" end="01:33.261">け</span><span begin="01:33.261" end="01:33.387">れ</span><span begin="01:33.387" end="01:34.621">ど</span>　<span begin="01:34.621" end="01:34.959">そ</span><span begin="01:34.959" end="01:35.441">の</span><span begin="01:35.441" end="01:36.004">ど</span><span begin="01:36.004" end="01:36.344">れ</span><span begin="01:36.344" end="01:36.712">よ</span><span begin="01:36.712" end="01:36.858">り</span><span begin="01:36.858" end="01:36.932">も</span><span ttm:role="x-translation" xml:lang="zh-CN">然而，比那一切更甚</span><span ttm:role="x-roman">Dakeredo, sono dore yori mo</span></p><p begin="01:37.259" end="01:39.694" ttm:agent="v1" itunes:key="L23"><span begin="01:37.259" end="01:37.531">一</span><span begin="01:37.531" end="01:38.738">番</span><span begin="01:38.738" end="01:38.937">痛</span><span begin="01:38.937" end="01:39.694">み</span><span ttm:role="x-translation" xml:lang="zh-CN">最为痛楚</span><span ttm:role="x-roman">Ichiban itami</span></p><p begin="01:40.036" end="01:42.725" ttm:agent="v1" itunes:key="L24"><span begin="01:40.036" end="01:40.113">傷</span><span begin="01:40.113" end="01:40.297">付</span><span begin="01:40.297" end="01:40.632">い</span><span begin="01:40.632" end="01:40.797">て</span><span begin="01:40.797" end="01:40.957">い</span><span begin="01:40.957" end="01:41.194">る</span><span begin="01:41.194" end="01:41.678">の</span><span begin="01:41.678" end="01:42.066">は</span><span begin="01:42.066" end="01:42.439">—</span><span begin="01:42.439" end="01:42.725">—</span><span ttm:role="x-translation" xml:lang="zh-CN">受伤最深的是——</span><span ttm:role="x-roman">Kizutsuite iru no wa——</span></p><p begin="01:43.032" end="01:45.607" ttm:agent="v1" itunes:key="L25"><span begin="01:43.032" end="01:43.178">行</span><span begin="01:43.178" end="01:43.328">先</span><span begin="01:43.328" end="01:43.682">無</span><span begin="01:43.682" end="01:44.371">き</span><span begin="01:44.371" end="01:44.705">鳴</span><span begin="01:44.705" end="01:45.132">咽</span><span begin="01:45.132" end="01:45.607">を</span><span ttm:role="x-translation" xml:lang="zh-CN">无处可去的哽咽</span><span ttm:role="x-roman">Yukisaki naki koe wo</span></p><p begin="01:45.687" end="01:47.958" ttm:agent="v1" itunes:key="L26"><span begin="01:45.687" end="01:45.759">そ</span><span begin="01:45.759" end="01:46.036">の</span><span begin="01:46.036" end="01:47.088">淚</span><span begin="01:47.088" end="01:47.301">の</span><span begin="01:47.301" end="01:47.481">わ</span><span begin="01:47.481" end="01:47.942">け</span><span begin="01:47.942" end="01:47.958">を</span><span ttm:role="x-translation" xml:lang="zh-CN">那泪水的缘由</span><span ttm:role="x-roman">Sono namida no wake wo</span></p><p begin="01:48.512" end="01:51.014" ttm:agent="v1" itunes:key="L27"><span begin="01:48.512" end="01:48.870">途</span><span begin="01:48.870" end="01:49.326">方</span><span begin="01:49.326" end="01:49.773">に</span>　<span begin="01:49.773" end="01:49.900">暮</span><span begin="01:49.900" end="01:50.050">れ</span><span begin="01:50.050" end="01:50.282">る</span><span begin="01:50.282" end="01:50.811">ほ</span><span begin="01:50.811" end="01:50.937">ど</span><span begin="01:50.937" end="01:51.014">に</span><span ttm:role="x-translation" xml:lang="zh-CN">茫然无措至极</span><span ttm:role="x-roman">Tohō ni kureru hodo ni</span></p><p begin="01:51.280" end="01:54.297" ttm:agent="v1" itunes:key="L28"><span begin="01:51.280" end="01:51.426">自</span><span begin="01:51.426" end="01:52.048">分</span><span begin="01:52.048" end="01:52.193">に</span><span begin="01:52.193" end="01:52.493">さ</span><span begin="01:52.493" end="01:52.632">え</span>　<span begin="01:52.632" end="01:53.005">わ</span><span begin="01:53.005" end="01:53.359">か</span><span begin="01:53.359" end="01:53.713">ら</span><span begin="01:53.713" end="01:54.025">な</span><span begin="01:54.025" end="01:54.297">い</span><span ttm:role="x-translation" xml:lang="zh-CN">连自己都无法明了</span><span ttm:role="x-roman">Jibun ni sae wakaranai</span></p><p begin="01:54.374" end="01:56.522" ttm:agent="v1" itunes:key="L29"><span begin="01:54.374" end="01:54.906">ど</span><span begin="01:54.906" end="01:55.314">れ</span><span begin="01:55.314" end="01:55.439">ほ</span><span begin="01:55.439" end="01:55.585">ど</span><span begin="01:55.585" end="01:55.750">の</span><span begin="01:55.750" end="01:56.522">数</span><span ttm:role="x-translation" xml:lang="zh-CN">不知多少次</span><span ttm:role="x-roman">Dore hodo no kazu</span></p><p begin="01:56.820" end="01:59.143" ttm:agent="v1" itunes:key="L30"><span begin="01:56.820" end="01:57.241">描</span><span begin="01:57.241" end="01:57.566">い</span><span begin="01:57.566" end="01:58.033">た</span><span begin="01:58.033" end="01:58.488">物</span><span begin="01:58.488" end="01:59.143">語</span><span ttm:role="x-translation" xml:lang="zh-CN">描绘过的故事</span><span ttm:role="x-roman">Egaita monogatari</span></p><p begin="01:59.563" end="02:02.063" ttm:agent="v1" itunes:key="L31"><span begin="01:59.563" end="01:59.675">そ</span><span begin="01:59.675" end="01:59.941">の</span><span begin="01:59.941" end="02:00.382">す</span><span begin="02:00.382" end="02:00.678">べ</span><span begin="02:00.678" end="02:00.964">て</span><span begin="02:00.964" end="02:01.229">が</span><span begin="02:01.229" end="02:01.709">一</span><span begin="02:01.709" end="02:02.063">切</span><span ttm:role="x-translation" xml:lang="zh-CN">那一切的一切</span><span ttm:role="x-roman">Sono subete ga issai</span></p><p begin="02:02.373" end="02:06.284" ttm:agent="v1" itunes:key="L32"><span begin="02:02.373" end="02:02.678">叶</span><span begin="02:02.678" end="02:03.280">わ</span><span begin="02:03.280" end="02:03.774">ぬ</span><span begin="02:03.774" end="02:03.900">夢</span><span begin="02:03.900" end="02:04.292">想</span><span begin="02:04.292" end="02:04.607">と</span><span begin="02:04.607" end="02:04.777">知</span><span begin="02:04.777" end="02:05.029">っ</span><span begin="02:05.029" end="02:05.281">た</span><span begin="02:05.281" end="02:05.480">と</span><span begin="02:05.480" end="02:05.800">き</span><span begin="02:05.800" end="02:06.047">…</span><span begin="02:06.047" end="02:06.284">…</span><span ttm:role="x-translation" xml:lang="zh-CN">当得知尽是无法企及的梦时……</span><span ttm:role="x-roman">Kanawanu yume to shitta toki……</span></p><p begin="02:05.555" end="02:10.663" ttm:agent="v1" itunes:key="L33"><span begin="02:05.555" end="02:05.700">あ</span><span begin="02:05.700" end="02:05.879">あ</span><span begin="02:05.879" end="02:06.427">、</span><span begin="02:06.427" end="02:06.592">い</span><span begin="02:06.592" end="02:06.752">つ</span><span begin="02:06.752" end="02:07.754">か</span><span begin="02:07.754" end="02:07.885">見</span><span begin="02:07.885" end="02:08.011">た</span><span begin="02:08.011" end="02:08.620">あ</span><span begin="02:08.620" end="02:08.993">の</span><span begin="02:08.993" end="02:09.490">星</span><span begin="02:09.490" end="02:09.959">よ</span><span begin="02:09.959" end="02:10.304">—</span><span begin="02:10.304" end="02:10.663">—</span><span ttm:role="x-translation" xml:lang="zh-CN">啊，那曾经仰望的星啊——</span><span ttm:role="x-roman">Aa, itsuka mita ano hoshi yo——</span></p><p begin="02:22.212" end="02:26.596" ttm:agent="v1" itunes:key="L34"><span begin="02:22.212" end="02:23.544">己</span><span begin="02:23.544" end="02:24.316">の</span><span begin="02:24.316" end="02:24.666">運</span><span begin="02:24.666" end="02:26.256">命</span><span begin="02:26.256" end="02:26.596">に</span><span ttm:role="x-translation" xml:lang="zh-CN">被自己的命运</span><span ttm:role="x-roman">Onore no unmei ni</span></p><p begin="02:27.003" end="02:31.820" ttm:agent="v1" itunes:key="L35"><span begin="02:27.003" end="02:27.670">裏</span><span begin="02:27.670" end="02:28.373">切</span><span begin="02:28.373" end="02:29.109">ら</span><span begin="02:29.109" end="02:29.818">れ</span><span begin="02:29.818" end="02:30.137">た</span><span begin="02:30.137" end="02:30.473">と</span><span begin="02:30.473" end="02:31.820">き</span><span ttm:role="x-translation" xml:lang="zh-CN">所背叛之时</span><span ttm:role="x-roman">Uragirareta toki</span></p><p begin="02:32.543" end="02:35.288" ttm:agent="v1" itunes:key="L36"><span begin="02:32.543" end="02:32.877">こ</span><span begin="02:32.877" end="02:33.217">の</span><span begin="02:33.217" end="02:33.897">世</span><span begin="02:33.897" end="02:34.653">界</span><span begin="02:34.653" end="02:35.288">は</span><span ttm:role="x-translation" xml:lang="zh-CN">这世界便</span><span ttm:role="x-roman">Kono sekai wa</span></p><p begin="02:35.696" end="02:38.066" ttm:agent="v1" itunes:key="L37"><span begin="02:35.696" end="02:36.373">罠</span><span begin="02:36.373" end="02:36.694">の</span><span begin="02:36.694" end="02:37.378">様</span><span begin="02:37.378" end="02:38.066">に</span><span ttm:role="x-translation" xml:lang="zh-CN">如陷阱一般</span><span ttm:role="x-roman">Wana no yō ni</span></p><p begin="02:38.454" end="02:42.985" ttm:agent="v1" itunes:key="L38"><span begin="02:38.454" end="02:38.808">お</span><span begin="02:38.808" end="02:39.491">前</span><span begin="02:39.491" end="02:39.868">を</span><span begin="02:39.868" end="02:40.149">呑</span><span begin="02:40.149" end="02:40.871">み</span><span begin="02:40.871" end="02:41.628">込</span><span begin="02:41.628" end="02:42.985">む</span><span ttm:role="x-translation" xml:lang="zh-CN">将你吞噬</span><span ttm:role="x-roman">Omae wo nomikomu</span></p><p begin="02:44.371" end="02:48.908" ttm:agent="v1" itunes:key="L39"><span begin="02:44.371" end="02:45.132">形</span><span begin="02:45.132" end="02:45.729">無</span><span begin="02:45.729" end="02:46.430">き</span><span begin="02:46.430" end="02:47.831">悪</span><span begin="02:47.831" end="02:48.500">意</span><span begin="02:48.500" end="02:48.908">の</span><span ttm:role="x-translation" xml:lang="zh-CN">无形之恶意</span><span ttm:role="x-roman">Katachi naki akui no</span></p><p begin="02:49.242" end="02:54.076" ttm:agent="v1" itunes:key="L40"><span begin="02:49.242" end="02:49.548">そ</span><span begin="02:49.548" end="02:49.902">の</span><span begin="02:49.902" end="02:50.605">大</span><span begin="02:50.605" end="02:51.259">き</span><span begin="02:51.259" end="02:51.754">さ</span><span begin="02:51.754" end="02:52.287">た</span><span begin="02:52.287" end="02:52.622">る</span><span begin="02:52.622" end="02:54.076">や</span><span ttm:role="x-translation" xml:lang="zh-CN">其浩大何如</span><span ttm:role="x-roman">Sono ōkisa taru ya</span></p><p begin="02:54.769" end="02:59.993" ttm:agent="v1" itunes:key="L41"><span begin="02:54.769" end="02:56.170">戦</span><span begin="02:56.170" end="02:56.490">う</span><span begin="02:56.490" end="02:56.849">に</span><span begin="02:56.849" end="02:57.523">は</span><span begin="02:57.523" end="02:57.773">そ</span><span begin="02:57.773" end="02:58.200">う</span><span begin="02:58.200" end="02:58.567">あ</span><span begin="02:58.567" end="02:58.961">ま</span><span begin="02:58.961" end="02:59.315">り</span><span begin="02:59.315" end="02:59.620">に</span><span begin="02:59.620" end="02:59.993">も</span><span ttm:role="x-translation" xml:lang="zh-CN">与之抗争实在太过</span><span ttm:role="x-roman">Tatakau ni wa sō amari ni mo</span></p><p begin="03:00.309" end="03:05.177" ttm:agent="v1" itunes:key="L42"><span begin="03:00.309" end="03:00.628">ち</span><span begin="03:00.628" end="03:01.002">っ</span><span begin="03:01.002" end="03:01.705">ぽ</span><span begin="03:01.705" end="03:02.029">け</span><span begin="03:02.029" end="03:02.384">な</span><span begin="03:02.384" end="03:03.819">勇</span><span begin="03:03.819" end="03:04.803">姿</span><span begin="03:04.803" end="03:05.177">…</span><span ttm:role="x-translation" xml:lang="zh-CN">渺小的英姿…</span><span ttm:role="x-roman">Chippoke na yūshi…</span></p><p begin="03:05.485" end="03:11.416" ttm:agent="v1" itunes:key="L43"><span begin="03:05.485" end="03:06.188">絶</span><span begin="03:06.188" end="03:07.204">望</span><span begin="03:07.204" end="03:07.543">の</span><span begin="03:07.543" end="03:08.562">淵</span>　<span begin="03:08.562" end="03:09.282">立</span><span begin="03:09.282" end="03:09.777">た</span><span begin="03:09.777" end="03:10.359">さ</span><span begin="03:10.359" end="03:10.679">る</span><span begin="03:10.679" end="03:11.018">る</span><span begin="03:11.018" end="03:11.144">も</span><span begin="03:11.144" end="03:11.416">の</span><span ttm:role="x-translation" xml:lang="zh-CN">被迫伫立于绝望深渊之人</span><span ttm:role="x-roman">Zetsubō no fuchi tatasaruru mono</span></p><p begin="03:12.010" end="03:17.276" ttm:agent="v1" itunes:key="L44"><span begin="03:12.010" end="03:12.645">そ</span><span begin="03:12.645" end="03:13.120">こ</span><span begin="03:13.120" end="03:13.456">に</span><span begin="03:13.456" end="03:13.848">死</span><span begin="03:13.848" end="03:14.345">は</span>　<span begin="03:14.345" end="03:14.510">甘</span><span begin="03:14.510" end="03:14.762">く</span><span begin="03:14.762" end="03:15.162">甘</span><span begin="03:15.162" end="03:15.366">く</span><span begin="03:15.366" end="03:15.893">忍</span><span begin="03:15.893" end="03:16.214">び</span><span begin="03:16.214" end="03:16.951">寄</span><span begin="03:16.951" end="03:17.276">る</span><span ttm:role="x-translation" xml:lang="zh-CN">死便在那里　甜蜜地、甜蜜地悄然逼近</span><span ttm:role="x-roman">Soko ni shi wa amaku amaku shinobiyoru</span></p><p begin="03:17.670" end="03:19.418" ttm:agent="v1" itunes:key="L45"><span begin="03:17.670" end="03:18.339">そ</span><span begin="03:18.339" end="03:18.662">う</span><span begin="03:18.662" end="03:18.807">だ</span><span begin="03:18.807" end="03:19.059">ろ</span><span begin="03:19.059" end="03:19.418">う</span><span ttm:role="x-translation" xml:lang="zh-CN">没错吧</span><span ttm:role="x-roman">Sō darō</span></p><p begin="03:20.063" end="03:22.651" ttm:agent="v1" itunes:key="L46"><span begin="03:20.063" end="03:20.402">そ</span><span begin="03:20.402" end="03:20.848">ん</span><span begin="03:20.848" end="03:21.430">な</span><span begin="03:21.430" end="03:22.356">運</span><span begin="03:22.356" end="03:22.651">命</span><span ttm:role="x-translation" xml:lang="zh-CN">那样的命运</span><span ttm:role="x-roman">Sonna unmei</span></p><p begin="03:22.699" end="03:24.993" ttm:agent="v1" itunes:key="L47"><span begin="03:22.699" end="03:22.845">生</span><span begin="03:22.845" end="03:22.995">き</span><span begin="03:22.995" end="03:24.096">て</span><span begin="03:24.096" end="03:24.246">い</span><span begin="03:24.246" end="03:24.391">て</span><span begin="03:24.391" end="03:24.993">も</span><span ttm:role="x-translation" xml:lang="zh-CN">纵然活着</span><span ttm:role="x-roman">Ikite ite mo</span></p><p begin="03:25.443" end="03:28.026" ttm:agent="v1" itunes:key="L48"><span begin="03:25.443" end="03:25.608">ど</span><span begin="03:25.608" end="03:25.768">う</span><span begin="03:25.768" end="03:26.141">し</span><span begin="03:26.141" end="03:26.306">よ</span><span begin="03:26.306" end="03:26.607">う</span><span begin="03:26.607" end="03:26.806">も</span><span begin="03:26.806" end="03:27.050">な</span><span begin="03:27.050" end="03:27.195">い</span><span begin="03:27.195" end="03:27.488">と</span><span begin="03:27.488" end="03:27.707">—</span><span begin="03:27.707" end="03:28.026">—</span><span ttm:role="x-translation" xml:lang="zh-CN">也无可奈何——</span><span ttm:role="x-roman">Dō shiyō mo nai to——</span></p><p begin="03:28.384" end="03:30.756" ttm:agent="v1" itunes:key="L49"><span begin="03:28.384" end="03:28.563">い</span><span begin="03:28.563" end="03:28.728">く</span><span begin="03:28.728" end="03:29.222">つ</span><span begin="03:29.222" end="03:29.718">も</span><span begin="03:29.718" end="03:29.973">願</span><span begin="03:29.973" end="03:30.133">つ</span><span begin="03:30.133" end="03:30.544">て</span><span begin="03:30.544" end="03:30.756">も</span><span ttm:role="x-translation" xml:lang="zh-CN">无论祈愿多少次</span><span ttm:role="x-roman">Ikutsu mo negatte mo</span></p><p begin="03:31.056" end="03:33.597" ttm:agent="v1" itunes:key="L50"><span begin="03:31.056" end="03:31.255">い</span><span begin="03:31.255" end="03:31.488">く</span><span begin="03:31.488" end="03:31.880">つ</span><span begin="03:31.880" end="03:32.412">も</span><span begin="03:32.412" end="03:32.610">望</span><span begin="03:32.610" end="03:32.850">ん</span><span begin="03:32.850" end="03:33.276">で</span><span begin="03:33.276" end="03:33.597">も</span><span ttm:role="x-translation" xml:lang="zh-CN">无论渴望多少次</span><span ttm:role="x-roman">Ikutsu mo nozonde mo</span></p><p begin="03:33.931" end="03:36.565" ttm:agent="v1" itunes:key="L51"><span begin="03:33.931" end="03:34.315">全</span><span begin="03:34.315" end="03:34.791">て</span><span begin="03:34.791" end="03:35.164">が</span>　<span begin="03:35.164" end="03:35.329">無</span><span begin="03:35.329" end="03:35.513">駄</span><span begin="03:35.513" end="03:35.726">だ</span><span begin="03:35.726" end="03:36.206">つ</span><span begin="03:36.206" end="03:36.347">た</span><span begin="03:36.347" end="03:36.565">と</span><span ttm:role="x-translation" xml:lang="zh-CN">一切都是徒劳——</span><span ttm:role="x-roman">Subete ga muda datta to</span></p><p begin="03:36.722" end="03:39.603" ttm:agent="v1" itunes:key="L52"><span begin="03:36.722" end="03:37.027">あ</span><span begin="03:37.027" end="03:37.465">あ</span>　<span begin="03:37.465" end="03:37.602">相</span><span begin="03:37.602" end="03:37.722">な</span><span begin="03:37.722" end="03:38.008">ら</span><span begin="03:38.008" end="03:38.449">ぬ</span><span begin="03:38.449" end="03:39.070">人</span><span begin="03:39.070" end="03:39.390">生</span><span begin="03:39.390" end="03:39.603">！</span><span ttm:role="x-translation" xml:lang="zh-CN">啊，事与愿违的人生！</span><span ttm:role="x-roman">Aa, ai naranu jinsei!</span></p><p begin="03:39.841" end="03:41.929" ttm:agent="v1" itunes:key="L53"><span begin="03:39.841" end="03:40.196">だ</span><span begin="03:40.196" end="03:40.324">か</span><span begin="03:40.324" end="03:40.677">ら</span>　<span begin="03:40.677" end="03:41.695">蹲</span><span begin="03:41.695" end="03:41.929">る</span><span ttm:role="x-translation" xml:lang="zh-CN">所以蜷缩起来</span><span ttm:role="x-roman">Dakara uzukumaru</span></p><p begin="03:42.255" end="03:44.716" ttm:agent="v1" itunes:key="L54"><span begin="03:42.255" end="03:42.420">そ</span><span begin="03:42.420" end="03:42.600">し</span><span begin="03:42.600" end="03:42.953">て</span><span begin="03:42.953" end="03:43.340">全</span><span begin="03:43.340" end="03:43.642">て</span><span begin="03:43.642" end="03:43.802">投</span><span begin="03:43.802" end="03:44.000">げ</span><span begin="03:44.000" end="03:44.461">出</span><span begin="03:44.461" end="03:44.604">す</span><span begin="03:44.604" end="03:44.716">?</span><span ttm:role="x-translation" xml:lang="zh-CN">然后放弃一切？</span><span ttm:role="x-roman">Soshite subete nagedasu?</span></p><p begin="03:44.974" end="03:47.603" ttm:agent="v1" itunes:key="L55"><span begin="03:44.974" end="03:45.139">か</span><span begin="03:45.139" end="03:45.357">く</span><span begin="03:45.357" end="03:45.851">な</span><span begin="03:45.851" end="03:46.278">れ</span><span begin="03:46.278" end="03:46.423">ば</span><span begin="03:46.423" end="03:46.619">お</span><span begin="03:46.619" end="03:47.254">前</span><span begin="03:47.254" end="03:47.380">は</span><span begin="03:47.380" end="03:47.477">も</span><span begin="03:47.477" end="03:47.603">う</span><span ttm:role="x-translation" xml:lang="zh-CN">若是如此你便不过是</span><span ttm:role="x-roman">Kaku nareba omae wa mō</span></p><p begin="03:47.766" end="03:52.258" ttm:agent="v1" itunes:key="L56"><span begin="03:47.766" end="03:47.945">食</span><span begin="03:47.945" end="03:48.163">い</span><span begin="03:48.163" end="03:48.678">で</span><span begin="03:48.678" end="03:49.192">の</span><span begin="03:49.192" end="03:49.337">あ</span><span begin="03:49.337" end="03:49.689">る</span><span begin="03:49.689" end="03:50.217">餌</span><span begin="03:50.217" end="03:50.455">で</span><span begin="03:50.455" end="03:50.760">し</span><span begin="03:50.760" end="03:50.939">か</span><span begin="03:50.939" end="03:51.260">な</span><span begin="03:51.260" end="03:51.565">い</span><span begin="03:51.565" end="03:51.900">…</span><span begin="03:51.900" end="03:52.258">…</span><span ttm:role="x-translation" xml:lang="zh-CN">一份可口的饵食而已……</span><span ttm:role="x-roman">Kuide no aru esa de shika nai……</span></p><p begin="03:50.938" end="03:56.179" ttm:agent="v1" itunes:key="L57"><span begin="03:50.938" end="03:51.084">あ</span><span begin="03:51.084" end="03:51.336">あ</span><span begin="03:51.336" end="03:51.854">、</span><span begin="03:51.854" end="03:52.086">星</span><span begin="03:52.086" end="03:53.232">を</span><span begin="03:53.232" end="03:53.586">見</span><span begin="03:53.586" end="03:54.396">失</span><span begin="03:54.396" end="03:54.716">う</span><span begin="03:54.716" end="03:54.881">よ</span><span begin="03:54.881" end="03:55.147">う</span><span begin="03:55.147" end="03:55.467">に</span><span begin="03:55.467" end="03:55.860">—</span><span begin="03:55.860" end="03:56.179">—</span><span ttm:role="x-translation" xml:lang="zh-CN">啊，仿佛再也望不见星辰——</span><span ttm:role="x-roman">Aa, hoshi wo miusinau yō ni——</span></p><p begin="03:56.514" end="04:00.958" ttm:agent="v1" itunes:key="L58"><span begin="03:56.514" end="03:57.160">だ</span><span begin="03:57.160" end="03:57.917">が</span>　<span begin="03:57.917" end="03:58.441">お</span><span begin="03:58.441" end="03:59.076">前</span><span begin="03:59.076" end="03:59.445">の</span><span begin="03:59.445" end="03:59.591">目</span><span begin="03:59.591" end="04:00.958">は</span><span ttm:role="x-translation" xml:lang="zh-CN">但，你的双眸</span><span ttm:role="x-roman">Daga, omae no me wa</span></p><p begin="04:01.681" end="04:03.181" ttm:agent="v1" itunes:key="L59"><span begin="04:01.681" end="04:01.850">未</span><span begin="04:01.850" end="04:02.100">だ</span><span begin="04:02.100" end="04:02.366">熾</span><span begin="04:02.366" end="04:02.740">火</span>　<span begin="04:02.740" end="04:02.871">そ</span><span begin="04:02.871" end="04:03.016">し</span><span begin="04:03.016" end="04:03.181">て</span><span ttm:role="x-translation" xml:lang="zh-CN">仍是炽火，而且</span><span ttm:role="x-roman">Mada okibi, soshite</span></p><p begin="04:03.468" end="04:06.845" ttm:agent="v1" itunes:key="L60"><span begin="04:03.468" end="04:03.579">今</span><span begin="04:03.579" end="04:03.764">尚</span><span begin="04:03.764" end="04:04.137">燃</span><span begin="04:04.137" end="04:04.302">え</span><span begin="04:04.302" end="04:04.448">る</span><span begin="04:04.448" end="04:04.613">と</span><span begin="04:04.613" end="04:04.812">き</span><span begin="04:04.812" end="04:05.299">を</span>　<span begin="04:05.299" end="04:05.914">待</span><span begin="04:05.914" end="04:06.845">つ</span><span ttm:role="x-translation" xml:lang="zh-CN">至今仍等待着燃烧之刻</span><span ttm:role="x-roman">Ima nao moeru toki wo matsu</span></p><p begin="04:07.617" end="04:12.061" ttm:agent="v1" itunes:key="L61"><span begin="04:07.617" end="04:08.237">尽</span><span begin="04:08.237" end="04:08.994">き</span><span begin="04:08.994" end="04:09.603">ぬ</span><span begin="04:09.603" end="04:10.582">怒</span><span begin="04:10.582" end="04:10.727">り</span><span begin="04:10.727" end="04:12.061">に</span><span ttm:role="x-translation" xml:lang="zh-CN">以不竭的怒火</span><span ttm:role="x-roman">Tsukinu ikari ni</span></p><p begin="04:12.612" end="04:14.955" ttm:agent="v1" itunes:key="L62"><span begin="04:12.612" end="04:12.774">燃</span><span begin="04:12.774" end="04:12.933">え</span><span begin="04:12.933" end="04:13.098">上</span><span begin="04:13.098" end="04:13.753">が</span><span begin="04:13.753" end="04:14.175">ら</span><span begin="04:14.175" end="04:14.320">せ</span><span begin="04:14.320" end="04:14.955">る</span><span ttm:role="x-translation" xml:lang="zh-CN">令其熊熊燃烧吧</span><span ttm:role="x-roman">Moeagaraseru</span></p><p begin="04:15.186" end="04:17.571" ttm:agent="v1" itunes:key="L63"><span begin="04:15.186" end="04:15.694">涙</span><span begin="04:15.694" end="04:15.912">の</span><span begin="04:15.912" end="04:16.926">乾</span><span begin="04:16.926" end="04:17.091">い</span><span begin="04:17.091" end="04:17.571">た</span><span ttm:role="x-translation" xml:lang="zh-CN">当泪水干涸</span><span ttm:role="x-roman">Namida no kawaita</span></p><p begin="04:17.958" end="04:20.788" ttm:agent="v1" itunes:key="L64"><span begin="04:17.958" end="04:18.227">そ</span><span begin="04:18.227" end="04:18.372">の</span><span begin="04:18.372" end="04:18.517">と</span><span begin="04:18.517" end="04:18.701">き</span><span begin="04:18.701" end="04:19.164">に</span><span begin="04:19.164" end="04:19.813">は</span><span begin="04:19.813" end="04:20.421">—</span><span begin="04:20.421" end="04:20.788">—</span><span ttm:role="x-translation" xml:lang="zh-CN">的那一刻——</span><span ttm:role="x-roman">Sono toki ni wa——</span></p><p begin="04:44.523" end="04:47.059" ttm:agent="v1" itunes:key="L65"><span begin="04:44.523" end="04:44.608">"</span><span begin="04:44.608" end="04:44.834">少</span><span begin="04:44.834" end="04:45.004">女</span><span begin="04:45.004" end="04:45.484">"</span><span begin="04:45.484" end="04:45.865">よ</span>　<span begin="04:45.865" end="04:46.011">立</span><span begin="04:46.011" end="04:46.232">ち</span><span begin="04:46.232" end="04:46.431">上</span><span begin="04:46.431" end="04:46.839">が</span><span begin="04:46.839" end="04:47.059">れ</span><span ttm:role="x-translation" xml:lang="zh-CN">「少女」啊，站起来</span><span ttm:role="x-roman">"Shōjo" yo, tachiagare</span></p><p begin="04:47.458" end="04:49.894" ttm:agent="v1" itunes:key="L66"><span begin="04:47.458" end="04:47.815">空</span><span begin="04:47.815" end="04:48.289">く</span><span begin="04:48.289" end="04:48.691">と</span>　<span begin="04:48.691" end="04:48.856">手</span><span begin="04:48.856" end="04:49.070">を</span><span begin="04:49.070" end="04:49.215">伸</span><span begin="04:49.215" end="04:49.642">ば</span><span begin="04:49.642" end="04:49.894">せ</span><span ttm:role="x-translation" xml:lang="zh-CN">向着天空　伸出双手</span><span ttm:role="x-roman">Aku to te wo nobase</span></p><p begin="04:50.279" end="04:52.541" ttm:agent="v1" itunes:key="L67"><span begin="04:50.279" end="04:51.092">己</span><span begin="04:51.092" end="04:51.502">を</span><span begin="04:51.502" end="04:51.735">害</span><span begin="04:51.735" end="04:52.003">す</span><span begin="04:52.003" end="04:52.410">運</span><span begin="04:52.410" end="04:52.541">命</span><span ttm:role="x-translation" xml:lang="zh-CN">戕害自身的命运</span><span ttm:role="x-roman">Onore wo gaisu unmei</span></p><p begin="04:53.033" end="04:56.067" ttm:agent="v1" itunes:key="L68"><span begin="04:53.033" end="04:53.164">た</span><span begin="04:53.164" end="04:53.336">だ</span>　<span begin="04:53.336" end="04:53.831">強</span><span begin="04:53.831" end="04:54.367">く</span><span begin="04:54.367" end="04:54.745">吠</span><span begin="04:54.745" end="04:55.138">え</span><span begin="04:55.138" end="04:55.754">返</span><span begin="04:55.754" end="04:55.906">せ</span><span begin="04:55.906" end="04:56.067">！</span><span ttm:role="x-translation" xml:lang="zh-CN">只管——放声吼回去！</span><span ttm:role="x-roman">Tada, tsuyoku hoekaese!</span></p><p begin="04:56.104" end="04:58.135" ttm:agent="v1" itunes:key="L69"><span begin="04:56.104" end="04:56.618">そ</span><span begin="04:56.618" end="04:57.005">の</span><span begin="04:57.005" end="04:57.951">物</span><span begin="04:57.951" end="04:58.135">語</span><span ttm:role="x-translation" xml:lang="zh-CN">那段物语</span><span ttm:role="x-roman">Sono monogatari</span></p><p begin="04:58.499" end="05:00.919" ttm:agent="v1" itunes:key="L70"><span begin="04:58.499" end="04:58.630">そ</span><span begin="04:58.630" end="04:58.795">れ</span><span begin="04:58.795" end="04:59.368">が</span><span begin="04:59.368" end="05:00.279">主</span><span begin="05:00.279" end="05:00.755">人</span><span begin="05:00.755" end="05:00.919">公</span><span ttm:role="x-translation" xml:lang="zh-CN">那便是主角</span><span ttm:role="x-roman">Sore ga Purotagonisuta</span></p><p begin="05:01.254" end="05:03.951" ttm:agent="v1" itunes:key="L71"><span begin="05:01.254" end="05:01.327">そ</span><span begin="05:01.327" end="05:01.617">れ</span><span begin="05:01.617" end="05:01.991">こ</span><span begin="05:01.991" end="05:02.136">そ</span><span begin="05:02.136" end="05:02.499">が</span>　<span begin="05:02.499" end="05:03.101">誰</span><span begin="05:03.101" end="05:03.561">で</span><span begin="05:03.561" end="05:03.760">も</span><span begin="05:03.760" end="05:03.886">な</span><span begin="05:03.886" end="05:03.951">い</span><span ttm:role="x-translation" xml:lang="zh-CN">那正是——非他人</span><span ttm:role="x-roman">Sore koso ga, dare de mo nai</span></p><p begin="05:04.150" end="05:09.335" ttm:agent="v1" itunes:key="L72"><span begin="05:04.150" end="05:04.315">お</span><span begin="05:04.315" end="05:05.004">前</span><span begin="05:05.004" end="05:05.517">の</span><span begin="05:05.517" end="05:05.677">あ</span><span begin="05:05.677" end="05:05.906">る</span>　<span begin="05:05.906" end="05:06.770">姿</span><span begin="05:06.770" end="05:07.017">な</span><span begin="05:07.017" end="05:07.274">の</span><span begin="05:07.274" end="05:07.769">だ</span><span begin="05:07.769" end="05:09.083">と</span><span begin="05:09.083" end="05:09.335">！</span><span ttm:role="x-translation" xml:lang="zh-CN">正是你应有之姿！</span><span ttm:role="x-roman">Omae no aru sugata na no da to!</span></p><p begin="05:07.242" end="05:12.499" ttm:agent="v1" itunes:key="L73"><span begin="05:07.242" end="05:07.576">あ</span><span begin="05:07.576" end="05:07.888">あ</span><span begin="05:07.888" end="05:08.102">、</span><span begin="05:08.102" end="05:08.244">い</span><span begin="05:08.244" end="05:08.355">つ</span><span begin="05:08.355" end="05:09.498">か</span><span begin="05:09.498" end="05:09.635">み</span><span begin="05:09.635" end="05:09.923">た</span><span begin="05:09.923" end="05:10.337">あ</span><span begin="05:10.337" end="05:10.699">の</span><span begin="05:10.699" end="05:11.084">星</span><span begin="05:11.084" end="05:11.722">は</span><span begin="05:11.722" end="05:12.095">—</span><span begin="05:12.095" end="05:12.373">—</span><span begin="05:12.373" end="05:12.499">！</span><span ttm:role="x-translation" xml:lang="zh-CN">啊，那曾经仰望的星——！</span><span ttm:role="x-roman">Aa, itsuka mita ano hoshi wa——!</span></p><p begin="05:12.320" end="05:14.700" ttm:agent="v1" itunes:key="L74"><span begin="05:12.320" end="05:12.557">空</span><span begin="05:12.557" end="05:13.711">よ</span>　<span begin="05:13.711" end="05:14.016">星</span><span begin="05:14.016" end="05:14.700">よ</span><span ttm:role="x-translation" xml:lang="zh-CN">苍穹啊，星辰啊</span><span ttm:role="x-roman">Sora yo, hoshi yo</span></p><p begin="05:14.980" end="05:17.585" ttm:agent="v1" itunes:key="L75"><span begin="05:14.980" end="05:15.072">そ</span><span begin="05:15.072" end="05:15.373">の</span><span begin="05:15.373" end="05:15.504">少</span><span begin="05:15.504" end="05:15.630">女</span><span begin="05:15.630" end="05:15.871">に</span><span begin="05:15.871" end="05:16.022">与</span><span begin="05:16.022" end="05:16.564">え</span><span begin="05:16.564" end="05:16.715">た</span><span begin="05:16.715" end="05:17.103">も</span><span begin="05:17.103" end="05:17.248">う</span><span begin="05:17.248" end="05:17.379">た</span><span begin="05:17.379" end="05:17.539">の</span><span begin="05:17.539" end="05:17.585">は</span><span ttm:role="x-translation" xml:lang="zh-CN">赐予那少女的</span><span ttm:role="x-roman">Sono ko ni ataeta mouta no wa</span></p><p begin="05:17.801" end="05:20.260" ttm:agent="v1" itunes:key="L76"><span begin="05:17.801" end="05:17.985">そ</span><span begin="05:17.985" end="05:18.131">れ</span><span begin="05:18.131" end="05:19.174">わ</span>　<span begin="05:19.174" end="05:19.320">希</span><span begin="05:19.320" end="05:19.481">望</span><span begin="05:19.481" end="05:19.941">—</span><span begin="05:19.941" end="05:20.260">—</span><span ttm:role="x-translation" xml:lang="zh-CN">那是——希望——</span><span ttm:role="x-roman">Sore wa kibō——</span></p><p begin="05:20.627" end="05:23.270" ttm:agent="v1" itunes:key="L77"><span begin="05:20.627" end="05:20.948">或</span><span begin="05:20.948" end="05:21.158">い</span><span begin="05:21.158" end="05:21.303">は</span><span begin="05:21.303" end="05:21.562">、</span><span begin="05:21.562" end="05:21.688">呪</span><span begin="05:21.688" end="05:21.974">い</span><span begin="05:21.974" end="05:22.270">の</span><span begin="05:22.270" end="05:22.925">類</span><span begin="05:22.925" end="05:23.051">か</span><span begin="05:23.051" end="05:23.270">？</span><span ttm:role="x-translation" xml:lang="zh-CN">亦或是，诅咒之类？</span><span ttm:role="x-roman">Arui wa, noroi no tagui ka?</span></p><p begin="05:23.352" end="05:25.619" ttm:agent="v1" itunes:key="L78"><span begin="05:23.352" end="05:23.691">あ</span><span begin="05:23.691" end="05:24.743">あ</span>　<span begin="05:24.743" end="05:25.150">夜</span><span begin="05:25.150" end="05:25.619">に</span><span ttm:role="x-translation" xml:lang="zh-CN">啊，在那夜里</span><span ttm:role="x-roman">Aa, yoru ni</span></p><p begin="05:26.162" end="05:28.684" ttm:agent="v1" itunes:key="L79"><span begin="05:26.162" end="05:26.502">空</span><span begin="05:26.502" end="05:26.547">高</span><span begin="05:26.547" end="05:27.031">く</span><span begin="05:27.031" end="05:27.178">見</span><span begin="05:27.178" end="05:27.705">上</span><span begin="05:27.705" end="05:27.836">げ</span><span begin="05:27.836" end="05:28.209">た</span><span begin="05:28.209" end="05:28.336">の</span><span begin="05:28.336" end="05:28.480">な</span><span begin="05:28.480" end="05:28.684">ら</span><span ttm:role="x-translation" xml:lang="zh-CN">若仰望高远的天空</span><span ttm:role="x-roman">Sora takaku miageta no nara</span></p><p begin="05:29.026" end="05:30.350" ttm:agent="v1" itunes:key="L80"><span begin="05:29.026" end="05:29.177">そ</span><span begin="05:29.177" end="05:29.322">こ</span><span begin="05:29.322" end="05:30.040">に</span><span begin="05:30.040" end="05:30.170">は</span><span begin="05:30.170" end="05:30.350">—</span><span ttm:role="x-translation" xml:lang="zh-CN">那里——</span><span ttm:role="x-roman">Soko ni wa—</span></p><p begin="05:30.825" end="05:34.521" ttm:agent="v1" itunes:key="L81"><span begin="05:30.825" end="05:31.150">い</span><span begin="05:31.150" end="05:31.504">つ</span><span begin="05:31.504" end="05:31.878">か</span><span begin="05:31.878" end="05:32.056">の</span>　<span begin="05:32.056" end="05:32.549">星</span><span begin="05:32.549" end="05:33.914">が</span><span begin="05:33.914" end="05:34.220">—</span><span begin="05:34.220" end="05:34.521">—</span><span ttm:role="x-translation" xml:lang="zh-CN">有那曾经的星——</span><span ttm:role="x-roman">Itsuka no hoshi ga——</span></p><p begin="05:34.983" end="05:40.453" ttm:agent="v1" itunes:key="L82"><span begin="05:34.983" end="05:35.686">ど</span><span begin="05:35.686" end="05:36.376">う</span><span begin="05:36.376" end="05:36.749">か</span><span begin="05:36.749" end="05:37.069">あ</span><span begin="05:37.069" end="05:37.442">る</span><span begin="05:37.442" end="05:37.602">よ</span><span begin="05:37.602" end="05:37.990">う</span><span begin="05:37.990" end="05:38.194">に</span><span begin="05:38.194" end="05:39.488">と</span><span begin="05:39.488" end="05:39.808">—</span><span begin="05:39.808" end="05:40.128">—</span><span begin="05:40.128" end="05:40.453">—</span><span ttm:role="x-translation" xml:lang="zh-CN">愿它仍在那里———</span><span ttm:role="x-roman">Dōka aru yō ni to———</span></p></div></body></tt>